[
  {
    "name": "userName",
    "displayName": "@UserID",
    "filters": {
      "required": [],
      "maxLength": [32],
      "regex": ["^[A-Za-z][A-Za-z0-9_]*$"]
    }
  },
  {
    "name": "dpNames",
    "displayName": "@DpName",
    "filters": {
      "required": [],
      "maxLength": [64]
    },
    "converter": "language"
  },
  {
    "name": "email",
    "displayName": "@Email",
    "filters": {
      "required": [],
      "email": [],
      "maxLength": [256]
    }
  },
  {
    "name": "phoneNumber",
    "displayName": "@Phone",
    "filters": {
      "regex": ["^[0-9+()\\-]{0,32}$"],
      "maxLength": [32]
    }
  }
]
