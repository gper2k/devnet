@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@{
    this.SetTitle(this.Lang("ResetPassword"));
    this.SetPageKey("ResetPassword");
    var uid = this.ViewData["Uid"] as string ?? string.Empty;
    var token = this.ViewData["Token"] as string ?? string.Empty;
    var hasValidParams = !string.IsNullOrWhiteSpace(uid) && !string.IsNullOrWhiteSpace(token);

    var pw = this.Context.GetService<Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions>>()?.Value.Password ?? new Microsoft.AspNetCore.Identity.PasswordOptions();
    var pwHint = string.Join(" · ", new[]
    {
        string.Format(this.Lang("MinCharsOf"), pw.RequiredLength),
        pw.RequireDigit ? this.Lang("RequireDigit") : null,
        pw.RequireLowercase ? this.Lang("RequireLowercase") : null,
        pw.RequireUppercase ? this.Lang("RequireUppercase") : null,
        pw.RequireNonAlphanumeric ? this.Lang("RequireNonAlphanumeric") : null,
        pw.RequiredUniqueChars > 1 ? $"{this.Lang("RequiredUniqueChars")} {pw.RequiredUniqueChars}" : null
    }.Where(p => p is not null));
}

@* 비밀번호 재설정 (메일 링크로 진입): 링크 값이 없으면 오류 안내 + 찾기/로그인 이동, 있으면 새 비밀번호 입력 *@
<section class="resetPassword">
    @if (!hasValidParams)
    {
        <div>
            <p>@this.Lang("ResetPwInvalidToken")</p>
            <nav>
                <a href="/Account/FindAccount?tab=pw" class="btn">@this.Lang("FindAccount")</a>
                <a href="@this.LoginUrl" class="btn point">@this.Lang("GoToSignIn")</a>
            </nav>
        </div>
    }
    else
    {
        <p>@this.Lang("EnterNewPassword")</p>
        <form method="post" action="/api/account/password/reset" novalidate>
            <input type="hidden" name="uid" value="@uid" />
            <input type="hidden" name="token" value="@token" />
            <div class="inputGrid single">
                <div class="fieldCol">
                    <label>@this.Lang("NewPassword")</label>
                    <input type="password" name="password" placeholder="@this.Lang("CreatePassword")" maxlength="128" required autofocus autocomplete="new-password" />
                </div>
            </div>
            <div class="inputGrid single">
                <div class="fieldCol">
                    <label>@this.Lang("PasswordConfirm")</label>
                    <input type="password" name="passwordConfirm" placeholder="@this.Lang("EnterPasswordConfirm")" maxlength="128" required autocomplete="new-password" />
                </div>
                <small>※ @pwHint</small>
            </div>
            <button type="submit" class="submitBtn">@this.Lang("ResetPassword")</button>
        </form>
    }
</section>

@section Scripts {
    <script type="module">
        const form = document.querySelector('section.resetPassword > form');
        // 필수 입력·일치 확인 후 전송 → 완료 안내를 닫으면 로그인 페이지로 이동 (비밀번호 규칙은 서버가 구성대로 검사)
        form?.addEventListener('submit', async e => {
            e.preventDefault();
            const empty = [...form.querySelectorAll('input[required]')].find(p => !p.value);
            if (empty) return empty.focus();
            if (form.password.value !== form.passwordConfirm.value) {
                await common.alert(@this.Js(this.Lang("PasswordMismatch")));
                return form.passwordConfirm.focus();
            }

            const res = await common.postSend(form.action, new FormData(form));
            if (!res?.success) return;
            await common.alert(res.data.notice);
            location.href = res.data.redirect;
        });
    </script>
}
