@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@using BitPlus.Web.Site.Services
@{
    Layout = null;
}

@* 컨텐츠 AI 서비스(검사 → 요약) 설정 양식 (서비스 설정 모달 본문에 붙는 조각) — AI 접속은 기능별로 고름(공용 조각 _AiConnection),
   요약: AI 접속(비우면 기본 접속)·순수 글 기준 길이·요약 지시문 / 검사: AI 접속(비우면 요약과 같은 접속), 사용, 알리기만(감추지 않음), 추가 검사 기준.
   입력 이름은 ContentSummaryService 의 설정 키와 같아야 한다. 값 채우기·저장은 Service.cshtml 이 맡는다. *@
<ul class="form">
    <li class="subTitle">@this.Lang("ContentSummaryTitle")</li>
    <partial name="~/Views/Manager/Service/Forms/_AiConnection.cshtml" />
    <li>
        <header>@this.Lang("ContentSummaryPlainLength") <small>@this.Lang("ContentSummaryPlainLengthInfo")</small></header>
        <input type="number" name="@ContentSummaryService.PlainLengthKey" min="0" max="20000" placeholder="@ContentSummaryService.DefaultPlainLength" />
    </li>
    <li>
        <header>@this.Lang("ContentSummaryPrompt") <small>@this.Lang("ContentSummaryPromptInfo")</small></header>
        <textarea name="@ContentSummaryService.PromptKey" rows="3" maxlength="2000" placeholder="@ContentSummaryService.DefaultPrompt"></textarea>
    </li>
    <li class="subTitle">@this.Lang("ContentReviewTitle")</li>
    <partial name="~/Views/Manager/Service/Forms/_AiConnection.cshtml" model='(ContentSummaryService.ReviewAiKey, "ContentReviewSameAi")' />
    <li class="flexRow">
        <label class="check"><input type="checkbox" name="@ContentSummaryService.ReviewKey" /><span>@this.Lang("ContentReviewUse")</span></label>
        <label class="check"><input type="checkbox" name="@ContentSummaryService.NotifyOnlyKey" /><span>@this.Lang("ContentReviewNotifyOnly")</span></label>
    </li>
    <li>
        <header>@this.Lang("ContentReviewCriteria") <small>@this.Lang("ContentReviewCriteriaInfo")</small></header>
        <textarea name="@ContentSummaryService.CriteriaKey" rows="3" maxlength="2000"></textarea>
    </li>
</ul>
