@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@{
    Layout = "_AdminLayout";
    this.SetTitle(this.Lang("DevKit"));
    this.SetPageKey("DevKit");
    this.SetDescription(this.Lang("DevKitInfo"));

    // 샘플 카탈로그 정의 — 새 샘플 추가 시 여기에 항목 추가
    var samples = new[]
    {
        new { Id = "sample",   Title = this.Lang("DevKitBasicStyle"), Icon = "fiBoard", Src = "/dev/document.html",   Tag = "Dashboard" },
        new { Id = "toolbar",  Title = this.Lang("DevKitToolbar"), Icon = "fiApps", Src = "/dev/toolbar.html",  Tag = "Controls" },
        new { Id = "treebox",  Title = this.Lang("DevKitTreeView"), Icon = "fiFolder", Src = "/dev/treebox.html",  Tag = "Controls" },
        new { Id = "controls", Title = this.Lang("DevKitInputControls"), Icon = "fiTag", Src = "/dev/controls.html", Tag = "Controls" },
        new { Id = "editorfile", Title = this.Lang("DevKitEditor"), Icon = "fiImage", Src = "/dev/editorfile.html", Tag = "Controls" },
    };
}

<div id="devKit">
    <!-- 카탈로그 사이드 패널 -->
    <aside id="devCatalog">
        <header>
            <i class="fi fiToolbox fiFill"></i>
            <span>Design Sample</span>
        </header>
        <nav>
            <ul id="sampleList">
                @foreach (var s in samples)
                {
                    <li data-target="@s.Id" onclick="openSample('@s.Id', this)">
                        <i class="fi @s.Icon"></i>
                        <div>
                            <strong>@s.Title</strong>
                            <small>@s.Tag</small>
                        </div>
                    </li>
                }
            </ul>
        </nav>
        <footer>
            <small>@this.Lang("DevKitSampleLocation"): <code>wwwroot/dev/*.html</code></small>
        </footer>
    </aside>

    <!-- iframe 뷰어 영역 -->
    <section id="devViewer">
        <header id="viewerHeader">
            <div id="viewerTitle">
                <i class="fi fiApps" id="viewerIcon"></i>
                <span id="viewerName">@this.Lang("DevKitSelectSample")</span>
                <span id="viewerTag" class="badge info" style="display:none;"></span>
            </div>
            <div id="viewerActions">
                <button type="button" class="btn sm" id="btnNewTab" title="@this.Lang("OpenNewTab")" style="display:none;" onclick="openNewTab()">
                    <i class="fi fiOpen"></i> @this.Lang("OpenNewTab")
                </button>
                <button type="button" class="btn sm" id="btnReload" title="@this.Lang("Refresh")" style="display:none;" onclick="reloadFrame()">
                    <i class="fi fiSync"></i>
                </button>
            </div>
        </header>

        <div id="viewerEmpty">
            <i class="fi fiApps fiFill"></i>
            <p>@this.Lang("DevKitEmptyInfo")</p>
        </div>

        <iframe id="devFrame" src="about:blank" style="display:none;" allowfullscreen></iframe>
    </section>
</div>

@section Styles {
    <style>
        /* DevKit 전체 레이아웃 */
        #devKit {
            display: flex;
            height: calc(100vh - 7.5em);
            gap: 0;
            border: 1px solid var(--lineColor);
            border-radius: var(--roundBox);
            overflow: hidden;
            background: var(--bgColor);
        }

        /* 좌측 카탈로그 패널 */
        #devCatalog {
            flex: 0 0 17em;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--lineColor);
            background: var(--bgSub);
        }

        #devCatalog > header {
            display: flex;
            align-items: center;
            gap: 0.5em;
            padding: 0.9em 1em;
            font-weight: 700;
            font-size: 0.95em;
            border-bottom: 1px solid var(--lineColor);
            background: var(--bgColor);
            color: var(--txColor);
        }

        #devCatalog > header > i.fi {
            font-size: 1.2em;
            color: var(--main);
        }

        #devCatalog > nav {
            flex: 1 1 auto;
            overflow-y: auto;
            padding: 0;
        }

        #sampleList {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.2em;
        }

        #sampleList > li {
            display: flex;
            align-items: center;
            gap: 0.65em;
            padding: 0.5em;
            border-radius: var(--roundSm);
            cursor: pointer;
            transition: background-color 0.15s ease;
            color: var(--txColor);
        }

        #sampleList > li:hover { background-color: var(--aLight); }
        #sampleList > li.active {
            background-color: var(--main0);
            box-shadow: inset 3px 0 0 var(--main);
        }

        #sampleList > li > i.fi {
            font-size: 1.3em;
            color: var(--txSub);
            flex-shrink: 0;
        }

        #sampleList > li.active > i.fi { color: var(--main); }

        #sampleList > li > div {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #sampleList > li > div > strong {
            font-size: 0.88em;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #sampleList > li > div > small {
            font-size: 0.75em;
            color: var(--txLight);
            line-height: 1em;
        }

        #devCatalog > footer {
            padding: 0.7em 1em;
            font-size: 0.75em;
            color: var(--txLight);
            border-top: 1px solid var(--lineColor);
        }

        #devCatalog > footer code {
            background: var(--aLight);
            padding: 0.1em 0.4em;
            border-radius: 0.25em;
            font-size: 0.95em;
        }

        /* 우측 iframe 뷰어 */
        #devViewer {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #viewerHeader {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1em;
            padding: 0.65em 1.2em;
            border-bottom: 1px solid var(--lineColor);
            background: var(--bgColor);
            min-height: 3.2em;
        }

        #viewerTitle {
            display: flex;
            align-items: center;
            gap: 0.6em;
            font-weight: 600;
            font-size: 0.92em;
        }

        #viewerTitle > i.fi { font-size: 1.25em; color: var(--main); }
        #viewerActions { display: flex; align-items: center; gap: 0.4em; }

        /* 빈 상태 안내 */
        #viewerEmpty {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0.8em;
            color: var(--txLight);
            text-align: center;
        }

        #viewerEmpty > i.fi { font-size: 3.5em; color: var(--aColor); }
        #viewerEmpty > p { margin: 0; line-height: 1.7; font-size: 0.95em; }
        #viewerEmpty > small { font-size: 0.8em; }
        #viewerEmpty code { background: var(--aLight); padding: 0.1em 0.4em; border-radius: 0.25em; }

        /* iframe */
        #devFrame {
            flex: 1 1 auto;
            border: none;
            width: 100%;
            height: 100%;
        }
    </style>
}

@section Scripts {
    <script>
        const samples = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            samples.Select(s => new { s.Id, s.Title, s.Icon, s.Src, s.Tag }),
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }
        ));
        let currentSampleId = null;

        function openSample(id, liEl) {
            const sample = samples.find(s => s.id === id);
            if (!sample) return;
            currentSampleId = id;

            // 목록 active 전환
            document.querySelectorAll('#sampleList > li').forEach(l => l.classList.remove('active'));
            if (liEl) liEl.classList.add('active');

            // 뷰어 헤더 갱신
            document.getElementById('viewerIcon').className = `fi ${sample.icon}`;
            document.getElementById('viewerName').textContent = sample.title;

            const tagEl = document.getElementById('viewerTag');
            tagEl.textContent = sample.tag;
            tagEl.style.display = 'inline';

            document.getElementById('btnNewTab').style.display = 'inline-flex';
            document.getElementById('btnReload').style.display = 'inline-flex';

            // iframe 전환
            document.getElementById('viewerEmpty').style.display = 'none';
            const frame = document.getElementById('devFrame');
            frame.style.display = 'block';
            frame.src = sample.src;
        }

        function reloadFrame() {
            const frame = document.getElementById('devFrame');
            if (frame.src && frame.src !== 'about:blank') frame.src = frame.src;
        }

        function openNewTab() {
            const sample = samples.find(s => s.id === currentSampleId);
            if (sample) window.open(sample.src, '_blank');
        }

        // 초기 첫 번째 샘플 자동 로드
        document.addEventListener('DOMContentLoaded', () => {
            const firstLi = document.querySelector('#sampleList > li');
            if (firstLi && samples.length > 0) openSample(samples[0].id, firstLi);
        });
    </script>
}
