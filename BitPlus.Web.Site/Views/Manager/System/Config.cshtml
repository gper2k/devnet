@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@{
    Layout = null;
    this.SetTitle(this.Lang("ConfigData"));
}

@* 시스템 설정 > 설정 관리 탭 조각 — Configs 테이블 키-값 목록(검색·페이지, api/config/settings, 마스터 키 제외), 행 클릭·추가 = 편집 모달(키(편집이면 고정)·범주·설명·사용·값).
   값이 JSON 이면 고친 값도 올바른 JSON 이어야 저장된다. 초기화는 System.cshtml 의 wireConfigPage() 가 맡는다. *@
<div class="pageBox configBox">
    <div class="inform fix">
        <header><i class="fi fiWarning"></i> @this.Lang("ConfigData")</header>
        <p>@this.Lang("ConfigDataInfo")</p>
    </div>

    <section class="card line flexCol auto">
        <header class="fix">
            <strong>
                <i class="fi fiDb"></i>
                @this.Lang("ConfigData")
                <i class="badge deco">0</i>
            </strong>
            <div class="flexRow gapSm alignCenter">
                <div class="inputGroup inline sm">
                    <input type="text" name="search" placeholder="@this.Lang("Search")" autocomplete="off" />
                    <button type="button" class="sub"><i class="fi fiSearch"></i></button>
                </div>
                <button type="button" class="sub sm" data-mode="add"><i class="fi fiAdd"></i> @this.Lang("Add")</button>
            </div>
        </header>

        <div class="dataList auto">
            <header>
                <span class="colCategory"><span>CATEGORY</span></span>
                <span class="colKey"><span>KEY</span></span>
                <span class="colValue"><span>VALUE</span></span>
                <span class="colFlag"><span>ENABLED</span></span>
                <span class="colDate"><span>DATE</span></span>
            </header>
            <ul></ul>
        </div>

        <footer class="fix">
            <div class="pageSize">
                <label>List Size</label>
                <select name="pageSize">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="30">30</option>
                </select>
            </div>
            <ul class="pager"></ul>
        </footer>
    </section>
</div>

<!-- 설정 편집 모달: 탭 기본 정보(키(편집이면 고정)·범주·설명) / Value(값 — JSON 이면 들여쓰기해 보여 줌), 하단 사용 체크·삭제(편집일 때만)·취소·저장 -->
<dialog id="configModal">
    <header><i class="fi fiDb"></i> <span></span></header>
    <section class="tabBox">
        <header>
            <span data-for="#configTabBasic" class="active">@this.Lang("BasicInfo")</span>
            <span data-for="#configTabValue">@this.Lang("Value")</span>
        </header>
        <section>
            <div id="configTabBasic" class="active">
                <ul class="form">
                    <li class="col2">
                        <div>
                            <header>@this.Lang("Key") <small class="txDanger">*</small></header>
                            <input type="text" name="key" maxlength="64" autocomplete="off" />
                        </div>
                        <div>
                            <header>@this.Lang("ContentCategory")</header>
                            <input type="text" name="category" maxlength="64" placeholder="AppConfig" autocomplete="off" />
                        </div>
                    </li>
                    <li>
                        <header>@this.Lang("Description")</header>
                        <textarea name="description" rows="8" maxlength="256"></textarea>
                    </li>
                </ul>
            </div>
            <div id="configTabValue">
                <ul class="form">
                    <li>
                        <header>@this.Lang("Value") <small data-json hidden>JSON</small></header>
                        <textarea name="value" spellcheck="false"></textarea>
                    </li>
                </ul>
            </div>
        </section>
    </section>
    <footer>
        <label class="check main"><input type="checkbox" name="enabled" /><span>@this.Lang("Enabler")</span></label>
        <button type="button" class="danger" data-mode="delete" hidden><i class="fi fiDelete"></i> @this.Lang("Delete")</button>
        <button type="button" onclick="this.closest('dialog').close()"><i class="fi fiBan"></i> @this.Lang("Cancel")</button>
        <button type="button" class="main" data-mode="save"><i class="fi fiSave"></i> @this.Lang("Save")</button>
    </footer>
</dialog>
