@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@using BitPlus.Web.Site.Models
@using Microsoft.AspNetCore.Mvc.ViewEngines
@{
    Layout = "_AdminLayout";
    this.SetTitle(this.Lang("ContentManage"));
    this.SetPageKey("Content");
    this.SetDescription(this.Lang("ContentManageInfo"));
    // 신규 게시판 유형(설정 화면이 있는 형식만): 게시판 탭의 추가 버튼 드롭다운
    var boardTypes = ContentPageModel.ManageTypes(this.Context.RequestServices.GetService(typeof(ICompositeViewEngine)) as ICompositeViewEngine)
        .Select(t => new { type = t.ToString(), text = this.Lang("ContentType" + t) }).ToList();
}

@* 컨텐츠 관리 — 탭 하나 = 관리 대상 하나. 탭 추가: ① 아래 header 에 a[data-tab] ② srcMap 에 조각 경로 ③ (필요 시) initTab 초기화 함수 ④ ManagerController 에 조각 뷰 액션 *@
<div class="tabView">
    <header class="frameTabs">
        <a data-tab="boards" href="#boards"><i class="fi fiDocOnePage"></i> @this.Lang("ContentBoards")</a>
        <a data-tab="pages" href="#pages"><i class="fi fiEdit"></i> @this.Lang("PageContents")</a>
        <a data-tab="fileRule" href="#fileRule"><i class="fi fiFolder"></i> @this.Lang("FileRule")</a>
        <a data-tab="reports" href="#reports"><i class="fi fiFlag"></i> @this.Lang("Report")</a>
    </header>
    <div class="frameBody">
        <div id="contentManage"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const srcMap = {
                boards: '/Manager/Content/Boards',
                pages: '/Manager/Content/Pages',
                fileRule: '/Manager/Content/FileRule',
                reports: '/Manager/Content/Reports'
            };
            const typeText = JSON.parse(@this.Js(System.Text.Json.JsonSerializer.Serialize(Enum.GetNames<BitPlus.Data.Content.ContentTypes>().ToDictionary(p => p, p => this.Lang("ContentType" + p)))));

            /** 탭 조각의 검색·목록 크기·페이저 목록 연결 (공용 common.bindPagedList — 조각 구조는 그 설명 참고) */
            const wireList = (urlOf, rowOf) => common.bindPagedList(document.getElementById('contentManage'), urlOf, rowOf);

            /** 목록 행(li) 한 줄 템플릿 (공용 common.listRow) */
            const rowOf = (data, cols) => common.listRow(data, cols);

            /** 배지 요소 */
            const badge = (text, color) => Object.assign(document.createElement('i'), { className: `badge sm ${color}`, textContent: text });

            // 게시판 — 컨텐츠 규칙 목록(보기 전용 제외, 비활성 포함). 행 클릭 = 게시판 설정(관리자 화면), 행 끝 ⋮ = 게시판 열기/설정. 추가 = 형식 드롭다운 → 신규 게시판 설정
            function wireBoardsPage() {
                const root = document.getElementById('contentManage');
                const boardTypes = JSON.parse(@this.Js(System.Text.Json.JsonSerializer.Serialize(boardTypes)));
                const settingsOf = ruleNo => `/Manager/Content/Board/${ruleNo}`;
                const canDelete = @(this.IsAllowed(WebConfig.ContentManagerPolicyName) ? "true" : "false"); // 게시판 삭제는 컨텐츠 관리자 정책만
                // 삭제 중인 게시판은 "삭제 중" 표시만 하고 설정·메뉴를 열지 않는다 (서버가 정리를 끝내면 목록에서 사라짐)
                const reload = wireList((page, size, q) => `/api/content/rules?page=${page}&pageSize=${size}&keyword=${encodeURIComponent(q)}`, item => rowOf({ ruleNo: item.ruleNo, deleting: item.deleting ? 'true' : '' }, [
                    ['colNo', item.ruleNo],
                    ['colName', item.title],
                    ['colType', badge(typeText[item.type] ?? item.type, 'sub')],
                    ['colCount', item.count],
                    ['colFlag', item.deleting ? badge(@this.Js(this.Lang("BoardDeleting")), 'danger') : item.enabler ? badge(@this.Js(this.Lang("Enabler")), 'point') : badge(@this.Js(this.Lang("NotUsed")), 'silver')],
                    ['colDate', common.localTime(item.cDate)],
                    ['colMore', item.deleting ? '' : Object.assign(document.createElement('i'), { className: 'fi fiEllipsisV' })]
                ]));
                root.querySelector('.dataList > ul').onclick = e => {
                    const li = e.target.closest('li[data-rule-no]');
                    if (!li || li.dataset.deleting) return;
                    const more = e.target.closest('.colMore');
                    if (!more) return location.href = settingsOf(li.dataset.ruleNo);
                    common.popMenu(more, [
                        { text: @this.Js(this.Lang("View")), icon: 'fi fiOpen', action: () => window.open(`/content/${li.dataset.ruleNo}`, '_blank') },
                        { text: @this.Js(this.Lang("BoardSettings")), icon: 'fi fiSettings', action: () => location.href = settingsOf(li.dataset.ruleNo) },
                        ...(canDelete ? [
                            { divider: true },
                            { text: @this.Js(this.Lang("Delete")), icon: 'fi fiDelete', danger: true, action: async () => { if (await common.modal.append('boardDelete', { ruleNo: Number(li.dataset.ruleNo) })) reload(); } }
                        ] : [])
                    ], 'right');
                };
                const add = root.querySelector('#addBoardBtn');
                add.onclick = () => common.popMenu(add, boardTypes.map(p => ({ text: p.text, icon: 'fi fiPlus', action: () => location.href = '/Manager/Content/Board?type=' + encodeURIComponent(p.type) })), 'right');
            }

            // 페이지 컨텐츠 — 보기 전용 규칙의 글(/view/{글 번호}) 목록. 행 클릭 = 관리자 수정 화면(/Manager/Content/Page/{글 번호}), 행 끝 ⋮ = 보기(새 창)/수정/삭제. 추가 = /Manager/Content/Page
            function wirePagesPage() {
                const root = document.getElementById('contentManage');
                const noTitle = @this.Js("(" + this.Lang("NoTitle") + ")");
                const reload = wireList((page, size, q) => `/api/content/list?type=PageView&page=${page}&size=${size}&q=${encodeURIComponent(q)}`, item => {
                    const flags = document.createElement('span');
                    if (item.start || item.end) flags.append(Object.assign(document.createElement('i'), { className: 'fi fiCalClock', title: `${item.start ? common.localTime(item.start, true) : ''} ~ ${item.end ? common.localTime(item.end, true) : ''}` }));
                    if (item.restricted) flags.append(Object.assign(document.createElement('i'), { className: 'fi fiShieldKeyhole', title: @this.Js(this.Lang("ReadPermission")) }));
                    return rowOf({ contentNo: item.contentNo }, [
                        ['colNo', item.contentNo],
                        ['colName', item.title || noTitle], // 예전에 제목 없이 저장된 글은 "(제목 없음)"
                        ['colAction', `/view/${item.contentNo}`],
                        ['colFlag', flags],
                        ['colDate', common.localTime(item.uDate)],
                        ['colMore', Object.assign(document.createElement('i'), { className: 'fi fiEllipsisV' })]
                    ]);
                });
                root.querySelector('.dataList > ul').onclick = e => {
                    const li = e.target.closest('li[data-content-no]');
                    if (!li) return;
                    const no = li.dataset.contentNo;
                    const more = e.target.closest('.colMore');
                    if (!more) return location.href = `/Manager/Content/Page/${no}`;
                    common.popMenu(more, [
                        { text: @this.Js(this.Lang("View")), icon: 'fi fiOpen', action: () => window.open(`/view/${no}`, '_blank') },
                        { text: @this.Js(this.Lang("Edit")), icon: 'fi fiEdit', action: () => location.href = `/Manager/Content/Page/${no}` },
                        { divider: true },
                        {
                            text: @this.Js(this.Lang("Delete")), icon: 'fi fiDelete', danger: true, action: async () => {
                                if (!await common.confirm(@this.Js(this.LangOf("DelMsg", "ContentManage") + " " + this.Lang("DelWarning")))) return;
                                const res = await common.delSend(`/api/content/post?type=PageView&contentNo=${no}`);
                                if (res && res.success) reload();
                            }
                        }
                    ], 'right');
                };
                root.querySelector('#addPageBtn').onclick = () => location.href = '/Manager/Content/Page';
            }

            // 파일 규칙 구성 — 목록 조회 및 등록/수정/삭제 모달, 권한 규칙(UpFileAccessRule) 서브 모달 연동
            function wireFileRulePage() {
                const root = document.querySelector('#contentManage');
                if (!root) return;

                const fileRuleModal = document.getElementById('fileRuleModal');
                const fileAccessRuleModal = document.getElementById('fileAccessRuleModal');

                const fileRuleState = {
                    keyword: '',
                    page: 0,
                    pageSize: 10,
                    editId: null
                };

                function formatBytes(bytes) {
                    if (bytes === null || bytes === undefined || bytes < 0) return '∞';
                    if (bytes === 0) return '0 B';
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
                    const i = Math.floor(Math.log(bytes) / Math.log(k));
                    return parseFloat((bytes / Math.pow(k, i)).toFixed(i === 0 ? 0 : 1)) + ' ' + sizes[i];
                }

                // 권한 규칙 행 렌더링 헬퍼
                function appendAccessRule(mode, type, key, text, isSystem = false) {
                    const list = fileRuleModal?.querySelector('#accessRuleItems');
                    if (!list) return;

                    const modeClass = (mode || '').toLowerCase();
                    const modeText = modeClass === 'upload' ? 'up' : 'down';
                    const li = document.createElement('li');
                    li.dataset.mode = mode;
                    li.dataset.type = type;
                    li.dataset.key = key;
                    li.dataset.text = text;
                    li.innerHTML = `
                        <div class="modeBox ${modeClass}" title="${mode}">${modeText}</div>
                        <div class="targetBox">
                            <span class="badge sm deco">${type}</span>
                            <span class="name">${text}</span>
                        </div>
                        ${isSystem ? '' : `<button type="button" class="delRuleBtn" title="@this.Js(this.Lang("Delete"))"><i class="fi fiDismiss"></i></button>`}
                    `;
                    list.appendChild(li);
                    common.syncEmpty(list);
                }

                // 파일 규칙 목록 조회
                async function loadList(page = fileRuleState.page) {
                    const list = root.querySelector('#fileRuleList');
                    if (!list) return;

                    fileRuleState.page = page;
                    const query = `keyword=${encodeURIComponent(fileRuleState.keyword)}&page=${page + 1}&pageSize=${fileRuleState.pageSize}`;
                    const res = await common.getSend(`/api/content/filerule/list?${query}`, { useLoading: false });
                    const data = (res && res.data) || { items: [], total: 0 };

                    const counter = root.querySelector('#ruleCounter');
                    if (counter) counter.textContent = data.total;

                    list.innerHTML = '';
                    (data.items || []).forEach(item => {
                        const li = document.createElement('li');
                        li.className = 'ruleRow';
                        li.dataset.id = item.id;
                        li.dataset.name = item.name;
                        li.dataset.isSystem = item.isSystem ? 'true' : 'false';

                        const extBadge = item.ext ? `<span class="badge sm silver">${item.ext}</span>` : '';
                        const countText = item.count < 0 ? '∞' : item.count;
                        const sizeText = formatBytes(item.size);
                        const totalSizeText = formatBytes(item.totalsize);
                        const dateText = common.localTime(item.cDate);
                        const sysBadge = item.isSystem ? ' <span class="badge sm deco">SYS</span>' : '';

                        li.innerHTML = `
                            <span class="colName">${item.name}${sysBadge}</span>
                            <span class="colWeb">${item.webroot}</span>
                            <span class="colExt">${extBadge}</span>
                            <span class="colCount">${countText}</span>
                            <span class="colSize">${sizeText}</span>
                            <span class="colTotal">${totalSizeText}</span>
                            <span class="colDate">${dateText}</span>
                        `;
                        list.appendChild(li);
                    });
                    common.syncEmpty(list);

                    const pager = root.querySelector('footer > ul.pager');
                    if (pager) pager.replaceWith(common.makePager(page, fileRuleState.pageSize, data.total).then(loadList));
                }

                // 파일 규칙 모달 열기 (신규 모드 또는 행 ID 로 상세 조회)
                async function openFileRuleModal(id = null) {
                    if (!fileRuleModal) return;
                    fileRuleState.editId = id;

                    // 첫 번째 탭(기본 정보) 활성화
                    fileRuleModal.querySelector('.tabBox > header > :first-child')?.click();

                    const isEdit = !!id;
                    const accessList = fileRuleModal.querySelector('#accessRuleItems');
                    if (accessList) {
                        accessList.innerHTML = '';
                        common.syncEmpty(accessList);
                    }

                    const delBtn = fileRuleModal.querySelector('footer button[data-mode="delete"]');
                    const saveBtn = fileRuleModal.querySelector('#fileRuleSaveBtn');
                    const addAccessBtn = fileRuleModal.querySelector('#addAccessRuleBtn');
                    const sysBadge = fileRuleModal.querySelector(':scope > header > span.badge');

                    if (isEdit) {
                        const res = await common.getSend(`/api/content/filerule/${id}`);
                        if (!res || !res.success) return;
                        const data = res.data;
                        const isSystem = !!data.isSystem;

                        if (sysBadge) sysBadge.hidden = !isSystem;
                        fileRuleModal.querySelector(':scope > header').innerHTML =
                            `<i class="fi ${isSystem ? 'fiFolderZip' : 'fiFolder'} fiFill"></i> ${isSystem ? @this.Js(this.Lang("FileRule") + " (" + this.Lang("System") + ")") : @this.Js(this.LangOf("EditOf", "FileRule"))} <span class="badge"${isSystem ? '' : ' hidden'}>SYS</span>`;

                        fileRuleModal.querySelector('input[name="name"]').value = data.name ?? '';
                        fileRuleModal.querySelector('input[name="registWebRoot"]').value = data.webroot ?? '';
                        fileRuleModal.querySelector('input[name="allowExtensions"]').value = data.ext ?? '';
                        fileRuleModal.querySelector('input[name="allowCount"]').value = data.count ?? -1;
                        fileRuleModal.querySelector('input[name="allowSize"]').value = data.size ?? -1;
                        fileRuleModal.querySelector('input[name="allowTotalSize"]').value = data.totalsize ?? -1;

                        // 시스템 항목인 경우 편집/삭제 비활성화
                        fileRuleModal.querySelectorAll('#fileRuleTabBasic input').forEach(el => el.disabled = isSystem);
                        if (addAccessBtn) addAccessBtn.hidden = isSystem;
                        if (saveBtn) saveBtn.hidden = isSystem;
                        if (delBtn) delBtn.hidden = isSystem;

                        (data.accessRules || []).forEach(r => appendAccessRule(r.mode, r.type, r.key, r.name, isSystem));
                    } else {
                        if (sysBadge) sysBadge.hidden = true;
                        fileRuleModal.querySelector(':scope > header').innerHTML =
                            `<i class="fi fiFolder fiFill"></i> ${@this.Js(this.LangOf("AddOf", "FileRule"))} <span class="badge" hidden>SYS</span>`;

                        fileRuleModal.querySelector('input[name="name"]').value = '';
                        fileRuleModal.querySelector('input[name="registWebRoot"]').value = '';
                        fileRuleModal.querySelector('input[name="allowExtensions"]').value = '';
                        fileRuleModal.querySelector('input[name="allowCount"]').value = '5';
                        fileRuleModal.querySelector('input[name="allowSize"]').value = '10485760';
                        fileRuleModal.querySelector('input[name="allowTotalSize"]').value = '52428800';

                        fileRuleModal.querySelectorAll('#fileRuleTabBasic input').forEach(el => el.disabled = false);
                        if (addAccessBtn) addAccessBtn.hidden = false;
                        if (saveBtn) saveBtn.hidden = false;
                        if (delBtn) delBtn.hidden = true;
                    }

                    fileRuleModal.showModal();
                }

                // 페이지 크기 초기화 및 변경
                const sizeSelect = root.querySelector('select[name="pageSize"]');
                if (sizeSelect) {
                    fileRuleState.pageSize = common.applyPageSize(sizeSelect);
                    sizeSelect.addEventListener('change', () => {
                        fileRuleState.pageSize = Number(sizeSelect.value);
                        loadList(0);
                    });
                }

                // 검색 처리
                const searchInput = root.querySelector('input[name="ruleSearch"]');
                const searchBtn = searchInput?.nextElementSibling;
                const doSearch = () => {
                    fileRuleState.keyword = searchInput?.value.trim() ?? '';
                    loadList(0);
                };
                searchBtn?.addEventListener('click', doSearch);
                searchInput?.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        doSearch();
                    }
                });

                // 규칙 추가 버튼
                root.querySelector('#addFileRuleBtn')?.addEventListener('click', () => openFileRuleModal(null));

                // 목록 행 클릭 시 편집 모달 오픈
                root.querySelector('#fileRuleList')?.addEventListener('click', (e) => {
                    const row = e.target.closest('li.ruleRow');
                    if (row && row.dataset.id) openFileRuleModal(row.dataset.id);
                });

                // 권한 규칙 탭: 규칙 추가 버튼 클릭 시 UpFileAccessRule 서브 모달 열기
                fileRuleModal?.querySelector('#addAccessRuleBtn')?.addEventListener('click', () => {
                    if (!fileAccessRuleModal) return;
                    fileAccessRuleModal.querySelector('input[name="accessMode"][value="Upload"]').checked = true;
                    fileAccessRuleModal.querySelector('input[name="targetType"][value="Role"]').checked = true;
                    fileAccessRuleModal.querySelector('input[name="targetName"]').value = '';
                    fileAccessRuleModal.querySelector('input[name="targetKey"]').value = '';
                    fileAccessRuleModal.showModal();
                });

                // 권한 규칙 서브 모달: 대상 찾기 버튼
                fileAccessRuleModal?.querySelector('#searchTargetBtn')?.addEventListener('click', async () => {
                    const targetType = fileAccessRuleModal.querySelector('input[name="targetType"]:checked')?.value;
                    const nameInput = fileAccessRuleModal.querySelector('input[name="targetName"]');
                    const keyInput = fileAccessRuleModal.querySelector('input[name="targetKey"]');

                    if (targetType === 'Role') {
                        const result = await common.modal.append('roleSelect', { max: 1 });
                        if (result && typeof result === 'object') {
                            const [key, text] = Object.entries(result)[0] ?? ['', ''];
                            keyInput.value = key;
                            nameInput.value = text;
                        }
                    } else if (targetType === 'Group' || targetType === 'Groups') {
                        const result = await common.modal.append('groupSelect', { max: 1 });
                        if (result && typeof result === 'object') {
                            const [key, text] = Object.entries(result)[0] ?? ['', ''];
                            keyInput.value = key;
                            nameInput.value = text;
                        }
                    } else if (targetType === 'User') {
                        const result = await common.modal.append('userSelect', { max: 1 });
                        if (result && typeof result === 'object') {
                            const [key, text] = Object.entries(result)[0] ?? ['', ''];
                            keyInput.value = key;
                            nameInput.value = text;
                        }
                    }
                });

                // 권한 규칙 적용 버튼 클릭 시 리스트에 추가
                fileAccessRuleModal?.querySelector('#applyAccessRuleBtn')?.addEventListener('click', () => {
                    const mode = fileAccessRuleModal.querySelector('input[name="accessMode"]:checked')?.value || 'Upload';
                    const type = fileAccessRuleModal.querySelector('input[name="targetType"]:checked')?.value || 'Role';
                    const targetName = fileAccessRuleModal.querySelector('input[name="targetName"]').value.trim();
                    const targetKey = fileAccessRuleModal.querySelector('input[name="targetKey"]').value.trim();

                    if (!targetKey) {
                        common.alert(@this.Js(this.Lang("NotSelectMsg")));
                        return;
                    }

                    // 중복 여부 확인
                    const existing = [...fileRuleModal.querySelectorAll('#accessRuleItems > li[data-key]')].some(li =>
                        li.dataset.mode === mode && li.dataset.type === type && li.dataset.key === targetKey
                    );
                    if (existing) {
                        common.alert(@this.Js(this.LangOf("ValidAlreadyItem", "FileAccessRule")));
                        return;
                    }

                    appendAccessRule(mode, type, targetKey, targetName || targetKey);
                    fileAccessRuleModal.close();
                });

                // 권한 규칙 행 삭제
                fileRuleModal?.querySelector('#accessRuleItems')?.addEventListener('click', (e) => {
                    const delBtn = e.target.closest('button.delRuleBtn');
                    if (!delBtn) return;
                    delBtn.closest('li')?.remove();
                    common.syncEmpty(e.currentTarget);
                });

                // 파일 규칙 저장 버튼 (신규 등록 및 수정)
                fileRuleModal?.querySelector('#fileRuleSaveBtn')?.addEventListener('click', async () => {
                    const name = fileRuleModal.querySelector('input[name="name"]').value.trim();
                    const registWebRoot = fileRuleModal.querySelector('input[name="registWebRoot"]').value.trim();
                    const allowExtensions = fileRuleModal.querySelector('input[name="allowExtensions"]').value.trim();
                    const allowCount = fileRuleModal.querySelector('input[name="allowCount"]').value.trim();
                    const allowSize = fileRuleModal.querySelector('input[name="allowSize"]').value.trim();
                    const allowTotalSize = fileRuleModal.querySelector('input[name="allowTotalSize"]').value.trim();

                    if (!name) {
                        common.alert(@this.Js(this.LangOf("ValidRequired", "Name")));
                        fileRuleModal.querySelector('.tabBox > header > :first-child')?.click();
                        fileRuleModal.querySelector('input[name="name"]').focus();
                        return;
                    }
                    if (!registWebRoot) {
                        common.alert(@this.Js(this.LangOf("ValidRequired", "RegistWebRoot")));
                        fileRuleModal.querySelector('.tabBox > header > :first-child')?.click();
                        fileRuleModal.querySelector('input[name="registWebRoot"]').focus();
                        return;
                    }

                    const accessRules = [...fileRuleModal.querySelectorAll('#accessRuleItems > li[data-key]')].map(li => ({
                        mode: li.dataset.mode,
                        type: li.dataset.type,
                        key: li.dataset.key
                    }));

                    const payload = {
                        name,
                        registWebRoot,
                        allowExtensions,
                        allowCount: allowCount || -1,
                        allowSize: allowSize || -1,
                        allowTotalSize: allowTotalSize || -1,
                        accessRules: JSON.stringify(accessRules)
                    };

                    const body = common.makeFormData(payload);
                    const res = fileRuleState.editId
                        ? await common.putSend(`/api/content/filerule/${fileRuleState.editId}`, body)
                        : await common.postSend('/api/content/filerule', body);

                    if (res && res.success) {
                        fileRuleModal.close();
                        loadList();
                    }
                });

                // 파일 규칙 삭제 버튼
                fileRuleModal?.querySelector('footer button[data-mode="delete"]')?.addEventListener('click', async () => {
                    if (!fileRuleState.editId) return;
                    const confirmed = await common.confirm(@this.Js(this.LangOf("DelMsg", "FileRule") + " " + this.Lang("DelWarning")));
                    if (!confirmed) return;

                    const res = await common.delSend(`/api/content/filerule/${fileRuleState.editId}`);
                    if (res && res.success) {
                        fileRuleModal.close();
                        loadList();
                    }
                });

                // 최초 목록 로드
                loadList(0);
            }

            // 신고 — 게시물·댓글 신고 목록(최신순). 행 클릭 = 신고 상세 창: 글 제목(새 창), 글쓴이·신고자(계정 관리 사용자 편집 창), 글(댓글) 삭제, 글 감추기/다시 보이기(글·포럼 답글만), 처리 완료(이 신고 한 건)
            function wireReportsPage() {
                const root = document.getElementById('contentManage');
                const modal = root.querySelector('#reportModal');
                const text = {
                    content: @this.Js(this.Lang("UserPosts")), comment: @this.Js(this.Lang("Comment")), hidden: @this.Js(this.Lang("Hide")), gone: @this.Js(this.Lang("ReportGone")),
                    resolveMsg: @this.Js(this.Lang("ReportResolveMsg")), countOf: @this.Js(this.Lang("ReportCountOf")),
                    deletePost: @this.Js(this.Lang("DeletePostMsg") + " " + this.Lang("DelWarning")), deleteComment: @this.Js(this.Lang("DeleteCommentMsg") + " " + this.Lang("DelWarning"))
                };
                const items = new Map();
                const stateOf = item => !item.exists ? badge(text.gone, 'silver') : item.hidden ? badge(text.hidden, 'warning') : '';
                const reload = wireList((page, size, q) => `/api/content/reports?page=${page}&pageSize=${size}&keyword=${encodeURIComponent(q)}`, item => {
                    items.set(item.id, item);
                    const name = document.createElement('span');
                    name.append(Object.assign(document.createElement('b'), { textContent: item.title }), ` · ${item.message}`);
                    return rowOf({ id: item.id }, [
                        ['colType', badge(item.target === 'Comment' ? text.comment : text.content, item.target === 'Comment' ? 'deco' : 'main')],
                        ['colName', name],
                        ['colAction', personOf(item.reporter, item.reporterUserName)],
                        ['colCount', item.reports],
                        ['colFlag', stateOf(item)],
                        ['colDate', common.localTime(item.cDate)]
                    ]);
                });

                // 상세 창: 값 채우고 버튼 보이기/숨기기. 글쓴이·신고자(이름 아이디)를 누르면 새 창에서 계정 관리의 사용자 편집 창(설명 등 저장)
                let current = null;
                const field = name => modal.querySelector(`[data-field="${name}"]`);
                const button = mode => modal.querySelector(`[data-mode="${mode}"]`);
                // 사용자 표시: 이름 + 작은 회색 아이디 (목록·상세 공용)
                const personOf = (name, userName) => {
                    const span = document.createElement('span');
                    span.append(name ?? '');
                    if (userName) span.append(' ', Object.assign(document.createElement('small'), { textContent: userName }));
                    return span;
                };
                // 사용자 정보 창: 이름·아이디·이메일과 설명(설명만 저장)
                const userModal = root.querySelector('#reportUserModal');
                const userField = name => userModal.querySelector(`[data-field="${name}"]`);
                let userId = null;
                const editUser = async id => {
                    const res = await common.getSend(`/api/membership/user/${id}`);
                    if (!res || !res.success) return;
                    const user = res.data;
                    userId = user.id;
                    userField('name').replaceChildren(personOf(user.text, user.userName));
                    userField('email').textContent = user.email ?? '';
                    userModal.querySelector('[name="description"]').value = user.description ?? '';
                    userModal.showModal();
                };
                userModal.querySelector('[data-mode="save"]').onclick = async () => {
                    const res = await common.patchSend(`/api/membership/user/${userId}/description`, common.makeFormData({ description: userModal.querySelector('[name="description"]').value }));
                    if (res && res.success) userModal.close();
                };
                const setPerson = (el, name, userName, id) => {
                    el.replaceChildren(personOf(name, userName));
                    el.onclick = e => { e.preventDefault(); if (userName) editUser(id); }; // 탈퇴한 사용자는 열 수 없음
                };
                const open = item => {
                    current = item;
                    field('target').textContent = `${item.board} · ${item.target === 'Comment' ? text.comment : text.content} · ${text.countOf.replace('{0}', item.reports)}`;
                    Object.assign(field('title'), { textContent: item.title, href: item.url ?? '#' });
                    field('excerpt').textContent = item.excerpt;
                    field('excerpt').hidden = !item.excerpt;
                    setPerson(field('writer'), item.writer, item.writerUserName, item.writerId);
                    setPerson(field('reporter'), item.reporter, item.reporterUserName, item.reporterId);
                    field('reportDate').textContent = common.localTime(item.cDate, true);
                    field('message').textContent = item.message;
                    button('delete').hidden = !item.exists || !item.ruleNo || !item.contentNo;
                    button('hide').hidden = item.target !== 'Content' || !item.exists || item.hidden;
                    button('show').hidden = item.target !== 'Content' || !item.exists || !item.hidden;
                    modal.showModal();
                };
                const done = res => {
                    if (!res || !res.success) return;
                    modal.close();
                    reload();
                };
                const hide = async hidden => done(await common.postSend(`/api/content/report/${current.id}/hide`, common.makeFormData({ hidden }), { useInfo: false }));
                // 삭제: 글(포럼 답글 포함)은 글 삭제, 기본 댓글은 댓글 삭제 — 게시판의 삭제 API 를 그대로 씀. 신고 기록은 남아 "삭제됨"으로 보임
                button('delete').onclick = async () => {
                    const isComment = current.target === 'Comment';
                    if (!await common.confirm(isComment ? text.deleteComment : text.deletePost)) return;
                    const query = new URLSearchParams({ ruleNo: current.ruleNo, contentNo: current.contentNo, ...(isComment ? { commentId: current.targetId } : {}) });
                    done(await common.delSend(`/api/content/${isComment ? 'comment' : 'post'}?${query}`));
                };
                button('hide').onclick = () => hide(true);
                button('show').onclick = () => hide(false);
                button('resolve').onclick = async () => {
                    if (!await common.confirm(text.resolveMsg)) return;
                    done(await common.delSend(`/api/content/report/${current.id}`));
                };
                root.querySelector('.dataList > ul').onclick = e => {
                    const li = e.target.closest('li[data-id]');
                    if (li) open(items.get(li.dataset.id));
                };
            }

            // 탭 연결 (공용 common.bindTabView — site.js 모듈이 준비된 뒤 실행)
            const initTab = { boards: wireBoardsPage, pages: wirePagesPage, fileRule: wireFileRulePage, reports: wireReportsPage };
            window.addEventListener('DOMContentLoaded', () => common.bindTabView(document.querySelector('.tabView'), srcMap, initTab));
        })();
    </script>
}
