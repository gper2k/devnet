@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@{
    Layout = "_AdminLayout";
    this.SetTitle(this.Lang("SystemSettings"));
    this.SetPageKey("System");
    this.SetDescription(this.Lang("SystemSettingsInfo"));
}

@* 시스템(전역) 설정 — 탭: 사이트 정보, 다국어 관리(Languages 테이블), 설정 관리(Configs 테이블), 로그(파일 로그 보기). 탭 하나 = 설정 묶음 하나. 탭 추가: ① 아래 header 에 a[data-tab] ② srcMap 에 조각 경로 ③ (필요 시) initTab 초기화 함수 ④ ManagerController 에 조각 뷰 액션 *@
<div class="tabView">
    <header class="frameTabs">
        <a data-tab="site" href="#site"><i class="fi fiGlobe"></i> @this.Lang("SiteInfo")</a>
        <a data-tab="language" href="#language"><i class="fi fiTranslate"></i> @this.Lang("LanguageData")</a>
        <a data-tab="config" href="#config"><i class="fi fiDb"></i> @this.Lang("ConfigData")</a>
        <a data-tab="log" href="#log"><i class="fi fiDocText"></i> @this.Lang("Log")</a>
    </header>
    <div class="frameBody">
        <div id="systemContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const srcMap = {
                site: '/Manager/System/Site',
                language: '/Manager/System/Language',
                config: '/Manager/System/Config',
                log: '/Manager/System/Log'
            };

            // 사이트 정보 — 현재 값을 입력칸(name)에 바인딩, 저장은 한 번에(api/config/site). 이미지 칸(data-image)의 업로드 버튼은 에디터 파일 API 로 올리고 받은 경로를 입력칸에 넣는다
            function wireSitePage() {
                const form = document.querySelector('#systemContent article');
                const inputs = [...form.querySelectorAll('input[name], textarea[name], select[name]')];
                // 언어 구성: 지원 언어 칩(순서 = 언어 메뉴 순서, 왼쪽으로 옮기기·지우기, 기본 언어는 지우기 없음) + 추가 선택, 기본 언어 선택. 저장은 사이트 정보와 함께(api/config/cultures)
                const cultureBox = form.querySelector('[data-section="cultures"]'), chips = cultureBox.querySelector('.chipBox > ul'), addSelect = cultureBox.querySelector('.chipBox select'), defaultSelect = cultureBox.querySelector('[data-default]');
                const culture = { list: [], names: {}, main: '' };
                const paintCultures = () => {
                    culture.main = defaultSelect.value || culture.main;
                    chips.replaceChildren(...culture.list.map((code, index) => {
                        const li = document.createElement('li');
                        li.innerHTML = '<span></span><button type="button" data-act="left"><i class="fi fiChevronLeft"></i></button><button type="button" data-act="remove"><i class="fi fiDismiss"></i></button>';
                        li.firstChild.textContent = `${culture.names[code] ?? code} (${code})`;
                        li.querySelector('[data-act="left"]').hidden = index === 0;
                        li.querySelector('[data-act="remove"]').hidden = code === culture.main;
                        li.onclick = e => {
                            const act = e.target.closest('button')?.dataset.act;
                            if (act === 'left') culture.list.splice(index - 1, 0, ...culture.list.splice(index, 1));
                            else if (act === 'remove') culture.list.splice(index, 1);
                            else return;
                            paintCultures();
                        };
                        return li;
                    }));
                    const option = code => { const o = document.createElement('option'); o.value = code; o.textContent = `${culture.names[code] ?? code} (${code})`; return o; };
                    addSelect.replaceChildren(...Object.keys(culture.names).filter(code => !culture.list.includes(code)).map(option));
                    defaultSelect.replaceChildren(...culture.list.map(option));
                    defaultSelect.value = culture.main;
                };
                defaultSelect.onchange = paintCultures;
                cultureBox.querySelector('.chipBox > footer > button').onclick = () => { if (addSelect.value) { culture.list.push(addSelect.value); paintCultures(); } };
                const loadCultures = async () => {
                    const res = await common.getSend('/api/config/cultures', { useLoading: false });
                    if (!res || !res.success) return;
                    culture.names = Object.fromEntries(res.data.available.map(p => [p.code, p.name]));
                    culture.list = [...res.data.cultures];
                    culture.main = res.data.culture;
                    defaultSelect.value = '';
                    paintCultures();
                };
                const load = async () => {
                    const [siteRes, layoutRes] = await Promise.all([
                        common.getSend('/api/config/site', { useLoading: false }),
                        common.getSend('/api/config/layouts', { useLoading: false })
                    ]);
                    if (layoutRes && layoutRes.success) {
                        const gSel = form.querySelector('[name="generalLayout"]');
                        const aSel = form.querySelector('[name="accountLayout"]');
                        if (gSel && layoutRes.data.general) {
                            gSel.innerHTML = layoutRes.data.general.map(v => `<option value="${v}">${v}</option>`).join('');
                        }
                        if (aSel && layoutRes.data.account) {
                            aSel.innerHTML = layoutRes.data.account.map(v => `<option value="${v}">${v}</option>`).join('');
                        }
                    }
                    const editorSelect = form.querySelector('[name="editor"]'); // 주 에디터: 클라이언트에 등록된 공급자, 저장값이 없거나 모르는 이름이면 지금 쓰는(기본) 에디터
                    editorSelect.replaceChildren(...common.editorNames.map(name => new Option(name, name)));
                    if (siteRes && siteRes.success) inputs.forEach(el => el.value = siteRes.data[el.name] ?? '');
                    if (!editorSelect.value) editorSelect.value = common.editorName;
                    loadCultures();
                };
                form.querySelectorAll('[data-image] > button').forEach(button => button.onclick = () => {
                    const picker = document.createElement('input');
                    picker.type = 'file';
                    picker.accept = 'image/*';
                    picker.onchange = async () => {
                        if (!picker.files.length) return;
                        const res = await common.postSend('/api/system/editor/file?ownerType=site.info&ownerKey=SiteInfo', common.makeFormData({ file: [...picker.files] }));
                        if (res && res.success && res.data.length) button.previousElementSibling.value = res.data[0].url; // 저장해야 등록됨 (저장하지 않은 업로드는 정리 대상)
                    };
                    picker.click();
                });
                form.querySelectorAll('.btnLayoutConfig').forEach(button => button.onclick = () => {
                    const category = button.dataset.category;
                    const select = button.previousElementSibling;
                    const layoutName = select?.value || 'Default';
                    const url = category === 'Account'
                        ? `/Account/SignIn?editable=1&layout=${encodeURIComponent(layoutName)}`
                        : `/?editable=1&layout=${encodeURIComponent(layoutName)}`;
                    window.open(url, '_blank');
                });
                form.querySelector('footer [data-mode="reset"]').onclick = load;
                form.querySelector('footer [data-mode="save"]').onclick = async () => {
                    const body = Object.fromEntries(inputs.map(el => [el.name, el.value.trim()]));
                    if (!body.title) { form.querySelector('[name="title"]').focus(); return common.alert(@this.Js(this.LangOf("ValidRequired", "SiteTitle"))); }
                    const res = await common.putSend('/api/config/site', common.makeFormData(body), { useInfo: false }); // 완료 알림은 이어지는 언어 구성 저장에서 한 번만
                    if (!res || !res.success) return;
                    const saved = await common.putSend('/api/config/cultures', common.makeFormData({ culture: culture.main, cultures: culture.list }));
                    if (saved && saved.success) load();
                };
                load();
            }

            // 다국어 관리 — 키(범주 + 키)별 목록(검색·페이지, 공용 common.bindPagedList), 추가·행 클릭 = 편집 모달(편집이면 범주·키 고정, 문화권별 값, 삭제)
            function wireLanguagePage() {
                const root = document.getElementById('systemContent');
                const modal = root.querySelector('#languageModal');
                const field = name => modal.querySelector(`[name="${name}"]`);
                const areas = [...modal.querySelectorAll('textarea[data-culture]')];
                const text = {
                    add: @this.Js(this.LangOf("AddOf", "LanguageData")),
                    edit: @this.Js(this.LangOf("EditOf", "LanguageData")),
                    del: @this.Js(this.Lang("DelWarning"))
                };
                let editing = null;

                const reload = common.bindPagedList(root, (page, size, q) => `/api/config/languages?page=${page}&pageSize=${size}&keyword=${encodeURIComponent(q)}`, item => {
                    const li = common.listRow({}, [
                        ['colCategory', item.category],
                        ['colKey', item.key],
                        ['colValue', Object.entries(item.values).map(([culture, value]) => `${culture}: ${value}`).join(' · ')],
                        ['colDate', common.localTime(item.uDate, true)]
                    ]);
                    li.children[2].title = li.children[2].textContent;
                    li.onclick = () => openModal(item);
                    return li;
                });

                // 모달 열기 (item 없으면 새로 등록) — 편집이면 범주·키를 고정하고 삭제 버튼을 보임
                const openModal = (item = null) => {
                    editing = item;
                    field('category').value = item?.category ?? '';
                    field('key').value = item?.key ?? '';
                    field('description').value = item?.description ?? '';
                    field('category').readOnly = field('key').readOnly = !!item;
                    areas.forEach(el => el.value = item?.values[el.dataset.culture] ?? '');
                    modal.querySelector(':scope > header > span').textContent = item ? text.edit : text.add;
                    modal.querySelector('[data-mode="delete"]').hidden = !item;
                    modal.showModal();
                };

                root.querySelector('[data-mode="add"]').onclick = () => openModal();
                modal.querySelector('[data-mode="save"]').onclick = async () => {
                    const values = Object.fromEntries(areas.map(el => [el.dataset.culture, el.value.trim()]).filter(([, v]) => v));
                    const body = { category: field('category').value.trim(), key: field('key').value.trim(), description: field('description').value.trim(), values: JSON.stringify(values), isNew: !editing };
                    const res = await common.putSend('/api/config/language', common.makeFormData(body));
                    if (!res || !res.success) return;
                    modal.close();
                    reload();
                };
                modal.querySelector('[data-mode="delete"]').onclick = async () => {
                    if (!editing || !await common.confirm(text.del)) return;
                    const res = await common.delSend(`/api/config/language?${new URLSearchParams({ category: editing.category, key: editing.key })}`);
                    if (!res || !res.success) return;
                    modal.close();
                    reload();
                };
            }

            // 설정 관리 — Configs 키-값 목록(검색·페이지, 마스터 키 제외), 추가·행 클릭 = 편집 모달(편집이면 키 고정, JSON 값은 들여쓰기해 보여 주고 저장 전 JSON 검사, 삭제)
            function wireConfigPage() {
                const root = document.getElementById('systemContent');
                const modal = root.querySelector('#configModal');
                const field = name => modal.querySelector(`[name="${name}"]`);
                const jsonMark = modal.querySelector('[data-json]');
                const text = {
                    add: @this.Js(this.LangOf("AddOf", "ConfigData")),
                    edit: @this.Js(this.LangOf("EditOf", "ConfigData")),
                    del: @this.Js(this.Lang("ConfigDeleteMsg")),
                    badJson: @this.Js(this.Lang("ConfigInvalidJson")),
                    enabled: @this.Js(this.Lang("Enabler")),
                    notUsed: @this.Js(this.Lang("NotUsed"))
                };
                const badge = (value, color) => Object.assign(document.createElement('i'), { className: `badge sm ${color}`, textContent: value });
                let editing = null;

                const reload = common.bindPagedList(root, (page, size, q) => `/api/config/settings?page=${page}&pageSize=${size}&keyword=${encodeURIComponent(q)}`, item => {
                    const li = common.listRow({}, [
                        ['colCategory', item.category],
                        ['colKey', item.key],
                        ['colValue', item.value],
                        ['colFlag', item.enabled ? badge(text.enabled, 'point') : badge(text.notUsed, 'silver')],
                        ['colDate', common.localTime(item.uDate, true)]
                    ]);
                    li.children[1].title = item.description ?? '';
                    li.onclick = () => openModal(item);
                    return li;
                });

                // 모달 열기 (item 없으면 새로 등록) — JSON 값은 보기 좋게 들여쓰기, 편집이면 키 고정·삭제 버튼
                const openModal = (item = null) => {
                    editing = item;
                    field('key').value = item?.key ?? '';
                    field('category').value = item?.category ?? '';
                    field('description').value = item?.description ?? '';
                    field('enabled').checked = item ? item.enabled : true;
                    field('value').value = item?.json ? JSON.stringify(JSON.parse(item.value), null, 2) : item?.value ?? '';
                    field('key').readOnly = !!item;
                    jsonMark.hidden = !item?.json;
                    modal.querySelector('.tabBox > header > span').click(); // 열 때마다 기본 정보 탭
                    modal.querySelector(':scope > header > span').textContent = item ? text.edit : text.add;
                    modal.querySelector('[data-mode="delete"]').hidden = !item;
                    modal.showModal();
                };

                root.querySelector('[data-mode="add"]').onclick = () => openModal();
                modal.querySelector('[data-mode="save"]').onclick = async () => {
                    let value = field('value').value;
                    if (editing?.json) {
                        try { value = JSON.stringify(JSON.parse(value)); } catch { common.alert(text.badJson); return; } // 원래 JSON 이면 고친 값도 JSON (한 줄로 저장)
                    }
                    const body = { key: field('key').value.trim(), category: field('category').value.trim(), description: field('description').value.trim(), value, enabled: field('enabled').checked, isNew: !editing };
                    const res = await common.putSend('/api/config/setting', common.makeFormData(body));
                    if (!res || !res.success) return;
                    modal.close();
                    reload();
                };
                modal.querySelector('[data-mode="delete"]').onclick = async () => {
                    if (!editing || !await common.confirm(text.del)) return;
                    const res = await common.delSend(`/api/config/setting/${encodeURIComponent(editing.key)}`);
                    if (!res || !res.success) return;
                    modal.close();
                    reload();
                };
            }

            // 로그 — 종류·날짜를 고르면 그 파일을 처음부터(시작 시각을 주면 그 근처부터) 읽고, 조건(시간·수준·검색어)을 바꾸면 다시 읽는다.
            // 큰 파일은 조건에 맞는 항목을 조금씩 받아 붙이고(더 보기 = 이어 읽기), 행을 누르면 원본 JSON 을 모달로 보여 준다(로그마다 구조가 달라 그대로 보여 줌)
            async function wireLogPage() {
                const root = document.getElementById('systemContent');
                const field = name => root.querySelector(`[name="${name}"]`);
                const list = root.querySelector('.dataList > ul');
                const more = root.querySelector('[data-mode="more"]');
                const position = root.querySelector('section.card > footer > span');
                const counter = root.querySelector('section.card > header .badge');
                const modal = root.querySelector('#logModal');
                const readOf = @this.Js(this.Lang("LogRead"));
                const colors = { Warning: 'warning', Error: 'danger', Critical: 'danger' };
                const badge = level => Object.assign(document.createElement('i'), { className: `badge sm ${colors[level] ?? 'silver'}`, textContent: level });
                const mb = bytes => `${(bytes / 1048576).toFixed(1)}MB`;
                const res = await common.getSend('/api/log/files', { useLoading: false });
                const files = (res && res.data && res.data.items) || [];
                let next = 0;

                // 종류 선택칸 = 로그 종류 이름, 날짜 선택칸 = 고른 종류의 날짜(최신순, 파일 크기 함께)
                [...new Set(files.map(p => p.kind))].sort().forEach(kind => field('kind').add(new Option(kind, kind)));
                const fillDates = () => {
                    field('date').innerHTML = '';
                    files.filter(p => p.kind === field('kind').value).forEach(p => field('date').add(new Option(`${p.date} (${mb(p.size)})`, p.file)));
                };

                /** 조건에 맞는 항목을 읽어 목록에 붙인다 (append 가 아니면 처음부터 다시) */
                const load = async append => {
                    if (!append) {
                        next = 0;
                        list.innerHTML = '';
                    }
                    const file = field('date').value;
                    if (file) {
                        const query = new URLSearchParams({ file, offset: next, from: field('from').value, to: field('to').value, level: field('level').value, keyword: field('search').value.trim(), take: 100 });
                        const r = await common.getSend(`/api/log/entries?${query}`);
                        const data = (r && r.data) || { items: [], next, size: 0, done: true };
                        data.items.forEach(item => {
                            const li = common.listRow({ offset: item.offset }, [['colTime', item.time], ['colLevel', item.level ? badge(item.level) : ''], ['colSummary', item.summary], ['colDuration', item.duration]]);
                            li.children[2].title = item.summary;
                            list.append(li);
                        });
                        next = data.next;
                        position.textContent = readOf.replace('{0}', mb(data.next)).replace('{1}', mb(data.size));
                        more.hidden = data.done;
                    } else {
                        position.textContent = '';
                        more.hidden = true;
                    }
                    common.syncEmpty(list);
                    counter.textContent = list.querySelectorAll(':scope > li:not(.empty)').length;
                };

                field('kind').onchange = () => {
                    fillDates();
                    load(false);
                };
                ['date', 'from', 'to', 'level'].forEach(name => field(name).onchange = () => load(false));
                field('search').onkeydown = e => {
                    if (e.key === 'Enter') load(false);
                };
                field('search').nextElementSibling.onclick = () => load(false);
                more.onclick = () => load(true);
                list.onclick = async e => {
                    const li = e.target.closest('li[data-offset]');
                    if (!li) return;
                    const r = await common.getSend(`/api/log/entry?file=${encodeURIComponent(field('date').value)}&offset=${li.dataset.offset}`);
                    if (!r || !r.success) return;
                    let text = r.data;
                    try {
                        text = JSON.stringify(JSON.parse(r.data), null, 2);
                    } catch { }
                    modal.querySelector(':scope > header > span').textContent = `${field('kind').value} · ${li.children[0].textContent}`;
                    modal.dataset.level = li.children[1].textContent.trim(); // 제외 규칙 추가 때 쓸 수준
                    modal.querySelector('pre').textContent = text;
                    modal.showModal();
                };

                // 로그 제외 규칙: 모달에서 줄(카테고리 앞부분 · 이 수준 이하 · 포함 글자)을 고쳐 저장하면 바로 적용(다른 서버는 1분 안에). 상세 모달에서 그 종류를 바로 추가
                const excludeModal = root.querySelector('#logExcludeModal'), excludeList = excludeModal.querySelector('ul'), excludeRow = excludeModal.querySelector('template');
                let excludeDefaults = [];
                const addRule = (rule = {}) => {
                    const li = excludeRow.content.firstElementChild.cloneNode(true);
                    li.querySelector('[name="category"]').value = rule.category ?? '';
                    li.querySelector('[name="maxLevel"]').value = rule.maxLevel ?? 'Information';
                    li.querySelector('[name="contains"]').value = rule.contains ?? '';
                    li.querySelector('[data-remove]').onclick = () => li.remove();
                    excludeList.append(li);
                    return li;
                };
                const openExclude = async extra => {
                    const r = await common.getSend('/api/log/exclude');
                    if (!r || !r.success) return;
                    excludeDefaults = r.data.defaults;
                    excludeList.replaceChildren();
                    r.data.rules.forEach(rule => addRule(rule));
                    if (extra) addRule(extra).querySelector('[name="contains"]').focus();
                    excludeModal.showModal();
                };
                root.querySelector('[data-mode="exclude"]').onclick = () => openExclude();
                modal.querySelector('[data-mode="excludeThis"]').onclick = () => { // 지금 보는 로그의 종류(카테고리)와 수준으로 새 줄 (경고 이상이면 Information 까지만)
                    const level = modal.dataset.level;
                    modal.close();
                    openExclude({ category: field('kind').value, maxLevel: ['Trace', 'Debug', 'Information'].includes(level) ? level : 'Information' });
                };
                const saveExclude = async () => {
                    const rules = [...excludeList.children].map(li => ({ category: li.querySelector('[name="category"]').value.trim(), maxLevel: li.querySelector('[name="maxLevel"]').value, contains: li.querySelector('[name="contains"]').value.trim() || null })).filter(p => p.category);
                    const res = await common.putSend('/api/log/exclude', common.makeFormData({ rules: JSON.stringify(rules) }));
                    if (res && res.success) excludeModal.close();
                };
                excludeModal.querySelector('[data-mode="current"]').onclick = () => { // 목록에 지금 보이는 종류(+ 검색어를 포함 글자로)를 Information 이하 제외 줄로 넣고 바로 저장 — 같은 줄이 이미 있으면 다시 넣지 않음
                    const rule = { category: field('kind').value, maxLevel: 'Information', contains: field('search').value.trim() };
                    if (!rule.category) return;
                    const same = [...excludeList.children].some(li => li.querySelector('[name="category"]').value.trim() === rule.category && li.querySelector('[name="contains"]').value.trim() === rule.contains);
                    if (!same) addRule(rule);
                    saveExclude();
                };
                excludeModal.querySelector('[data-mode="add"]').onclick = () => addRule().querySelector('input').focus();
                excludeModal.querySelector('[data-mode="defaults"]').onclick = () => { excludeList.replaceChildren(); excludeDefaults.forEach(rule => addRule(rule)); };
                excludeModal.querySelector('[data-mode="save"]').onclick = saveExclude;

                fillDates();
                load(false);
            }

            // 탭 연결 (공용 common.bindTabView — site.js 모듈이 준비된 뒤 실행)
            const initTab = { site: wireSitePage, language: wireLanguagePage, config: wireConfigPage, log: wireLogPage };
            window.addEventListener('DOMContentLoaded', () => common.bindTabView(document.querySelector('.tabView'), srcMap, initTab));
        })();
    </script>
}
