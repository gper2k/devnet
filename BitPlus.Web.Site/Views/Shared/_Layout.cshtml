@inherits BitPlus.Web.HTTP.View.LayoutBase<dynamic>
@{
    // 문서 머리 정보: 관리자 "시스템 설정 > 사이트 정보"(SiteInfo). 공유 미리보기(Open Graph·X 카드)의 설명·이미지는 화면이 ViewData["MetaDescription"]·["MetaImage"] 로 바꿀 수 있다(예: 글 보기)
    var site = SiteInfo.Of(this.Config);
    var origin = $"{this.Context.Request.Scheme}://{this.Context.Request.Host}";
    var absolute = (string? path) => string.IsNullOrEmpty(path) ? null : path.StartsWith('/') ? origin + path : path;
    var metaDescription = ViewData["MetaDescription"] as string is { Length: > 0 } pageDescription ? pageDescription : site.Description;
    var metaImage = absolute(ViewData["MetaImage"] as string is { Length: > 0 } pageImage ? pageImage : site.ShareImage is { Length: > 0 } ? site.ShareImage : site.Logo);
    // Google Analytics: "시스템 설정 > 외부 연동" 의 측정 ID 가 있을 때만. 관리자 화면(_AdminLayout 이 ViewData["NoAnalytics"] 를 켬)은 수집하지 않는다
    var gaId = ViewData["NoAnalytics"] is true ? "" : SiteIntegration.Of(this.Config).GaMeasurementId;
}
<!DOCTYPE html>
<html lang="@(this.CurrentCulture.TwoLetterISOLanguageName)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(this.Title.IsNotNull() ? $"{this.Title} - " : "")@site.Title</title>
    @if (!string.IsNullOrEmpty(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    @if (!string.IsNullOrEmpty(site.Keywords))
    {
        <meta name="keywords" content="@site.Keywords" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@site.Title" />
    <meta property="og:title" content="@(this.Title.IsNotNull() ? this.Title : site.Title)" />
    <meta property="og:url" content="@(origin + this.Context.Request.Path + this.Context.Request.QueryString)" />
    @if (!string.IsNullOrEmpty(metaDescription))
    {
        <meta property="og:description" content="@metaDescription" />
    }
    @if (metaImage is not null)
    {
        <meta property="og:image" content="@metaImage" />
    }
    <meta name="twitter:card" content="@(metaImage is null ? "summary" : "summary_large_image")" />
    <link rel="icon" href="@site.Favicon">
    <link rel="stylesheet" href="~/lib/fluenticons/fluenticons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BitPlus.Web.Site.styles.css" asp-append-version="true" />
    @if (gaId.Length > 0)
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@gaId');
        </script>
    }
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Header", required: false)
</head>
<body class="@this.BodyClass" data-theme="@(this.Theme ?? (ViewData["UserTheme"] is true && this.Context.Request.Cookies["Theme"] is "dark" or "light" ? this.Context.Request.Cookies["Theme"] : null))"> @* 테마: 화면이 정한 값, 없으면 회원 환경설정의 Theme 쿠키(_PageLayout·_AdminLayout 이 ViewData["UserTheme"] 를 켬, 계정 레이아웃은 기본 테마) *@
    @if (this.HasAlert)
    {
        <aside class="alert-banner alert-@this.AlertType" role="alert">
            <i class="fi fiInfo"></i>
            <span>@this.AlertMessage</span>
        </aside>
    }

    @* 메일 검증 경고 모드: 인증 전 사용자에게 모든 페이지 맨 위에서 계속 안내 (인증/재발송 페이지로 이동, 그 페이지 자신은 제외) *@
    @if (this.PageKey != "VerifyMail" && this.CurrentUser is { EmailConfirmed: false } me && this.Config?.AccountRule.MailVerify == BitPlus.Data.Account.MailVerifyMode.Warning)
    {
        <aside class="mailNotice">
            <i class="fi fiWarning fiFill"></i>
            <span>@this.Lang("MailVerifyNotice")</span>
            <a href="/Account/VerifyMail?uid=@Uri.EscapeDataString(me.UserName)&returnUrl=@Uri.EscapeDataString(this.Context.Request.Path + this.Context.Request.QueryString)">@this.Lang("ResendMail")</a>
        </aside>
    }

    @RenderBody()

    <div id="modals"></div>
    <div id="messages"></div>

    <script type="module">
        import { Site } from "/js/site.js";
        new Site({ ...@this.ClientConfigJson(), editor: @this.Js(site.Editor) }); // 주 에디터: 사이트 정보(SiteInfo.Editor)
    </script>
    <script>
        document.querySelectorAll("[data-class-bind]").forEach(p => {
            const key = p.getAttribute("data-class-bind");
            const value = sessionStorage.getItem(key);
            if (value && !p.classList.contains(value)) p.classList.add(value);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
