@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // 오른쪽 위 알림·메시지 드롭다운: 열 때마다 최근 안 읽은 목록을 다시 받고, 항목의 확인 버튼은 읽음 처리 후 목록에서 빼고 뱃지 수를 줄인다
        (function() {
            const confirmText = @this.Js(this.Lang("Confirm"));
            const kinds = {
                notice: { list: "/api/user/notice?unreadOnly=true", read: id => `/api/user/notice/read/${id}`, title: item => item.text, url: item => item.url, sub: () => "" },
                message: { list: "/api/user/message/unread", read: id => `/api/user/message/read/${id}`, title: item => item.message, url: () => "/user/message", sub: item => item.name }
            };

            /** 목록 항목 하나: 제목(이동 주소가 있으면 새 탭 링크) · 보낸 사람 · 시각 + 확인 버튼 */
            function rowOf(kind, item) {
                const li = document.createElement("li");
                li.dataset.id = item.id;
                li.innerHTML = `<div><a target="_blank"></a><small></small></div><button type="button" class="xs main">${confirmText}</button>`;
                const link = li.querySelector("a");
                link.textContent = kind.title(item);
                if (kind.url(item)) link.href = kind.url(item);
                li.querySelector("small").textContent = [kind.sub(item), common.localTime(item.cDate, true)].filter(Boolean).join(" · ");
                return li;
            }

            document.querySelectorAll("#app > article > header > .right > div[data-kind]").forEach(box => {
                const kind = kinds[box.dataset.kind];
                const list = box.querySelector("ul");
                const badge = box.querySelector(":scope > span > b");
                const setCount = count => { badge.textContent = count; badge.hidden = count <= 0; };

                box.querySelector(":scope > span").addEventListener("click", async () => {
                    const open = !box.classList.contains("open");
                    box.classList.toggle("open", open);
                    box.classList.toggle("active", open);
                    if (!open) return;
                    const res = await common.getSend(kind.list, { useLoading: false });
                    const data = (res && res.data) || { items: [], unread: 0 };
                    list.innerHTML = "";
                    data.items.forEach(item => list.appendChild(rowOf(kind, item)));
                    common.syncEmpty(list);
                    setCount(data.unread);
                });
                box.querySelector(":scope > section").addEventListener("click", e => e.stopPropagation());
                list.addEventListener("click", async e => {
                    const btn = e.target.closest("button");
                    if (!btn) return;
                    const li = btn.closest("li");
                    const res = await common.postSend(kind.read(li.dataset.id), new FormData(), { useLoading: false, useInfo: false });
                    if (!res || !res.success) return;
                    li.remove();
                    common.syncEmpty(list);
                    setCount(Number(badge.textContent) - 1);
                });
            });
        })();
    </script>
}
