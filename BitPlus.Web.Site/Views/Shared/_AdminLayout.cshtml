@inherits BitPlus.Web.HTTP.View.LayoutBase<dynamic>
@using BitPlus.Web.Data
@using Microsoft.EntityFrameworkCore
@{
    Layout = "_Layout";
    ViewData["UserTheme"] = true; // 회원 환경설정의 테마(Theme 쿠키)를 관리자 레이아웃에도 적용 (_Layout)
    ViewData["NoAnalytics"] = true; // 관리자 화면은 Google Analytics 수집 안 함 (_Layout)
    // 사이드바 메뉴: DB 의 "Manager" 메뉴 하위(사용 중 + 현재 사용자가 접근 가능) 를 정렬 순서대로 그린다
    var menus = await MenuReader.ReadAsync(this.DbContext!, "Manager", this.CurrentUserAssets);
    // 현재 메뉴: 현재 경로가 이동 경로와 같거나 그 하위인 메뉴 중 이동 경로가 가장 긴 것 (/Manager 는 정확히 일치할 때만)
    var path = this.Context.Request.Path.Value?.TrimEnd('/') ?? string.Empty;
    var activeKey = menus.Where(p => p.Action is { Length: > 0 } && (path.Equals(p.Action.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) || path.StartsWith(p.Action.TrimEnd('/') + "/", StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(p => p.Action!.Length).FirstOrDefault()?.Key;
    // 오른쪽 위 뱃지: 확인하지 않은 알림 수, 안 읽은 받은 메시지 수
    var db = (Microsoft.EntityFrameworkCore.DbContext)this.DbContext!;
    var uid = this.CurrentUserId;
    var unreadNotice = uid is null ? 0 : await db.Set<BitPlus.Data.Account.Model.AppUserNotice>().CountAsync(p => p.ReceiverId == uid && p.RDate == null);
    var unreadMessage = uid is null ? 0 : await db.Set<BitPlus.Data.Account.Model.AppUserMessage>().CountAsync(p => p.ReceiverId == uid && p.RDate == null && !p.ReceiverDeleted);
}
<div id="app" class="adminLayout ready" data-class-bind="mgmt@Side">
    <!-- 사이드바 네비게이션 -->
    <aside>
        <header>
            <div>
                <svg class="ham hamRotate ham7" viewBox="0 0 100 100" onclick="if(window.common) common.openedToggle(document.getElementById('app'), 'mgmt@Side'); else document.getElementById('app').classList.toggle('opened');">
                    <path class="hamLine mainStroke top" d="m 70,33 h -40 c 0,0 -6,1.368796 -6,8.5 0,7.131204 6,8.5013 6,8.5013 l 20,-0.0013"></path>
                    <path class="hamLine mainStroke middle" d="m 70,50 h -40"></path>
                    <path class="hamLine mainStroke bottom" d="m 69.575405,67.073826 h -40 c -5.592752,0 -6.873604,-9.348582 1.371031,-9.348582 8.244634,0 19.053564,21.797129 19.053564,12.274756 l 0,-40"></path>
                </svg>
            </div>
            <span></span>
        </header>
        <nav>
            <ul>
                @foreach (var menu in menus)
                {
                    <li class="@(menu.Key == activeKey ? "active" : "")" data-href="@(menu.Type == BitPlus.Data.SiteMap.LinkType.Move ? menu.Action : null)" onclick="if (this.dataset.href) location.href = this.dataset.href">
                        <header>@(new Microsoft.AspNetCore.Html.HtmlString(menu.Icon ?? string.Empty))</header>
                        <span>@this.Context.Request.DisplayName(menu.DpNames, menu.Key)</span>
                    </li>
                }
            </ul>
        </nav>
        <footer>
            <ul>
            </ul>
        </footer>
    </aside>

    <!-- 메인 관리자 아티클 영역 -->
    <article>
        <header>
            <div>
                <span class="logo" onclick="location.href='/Manager'">
                    Bit<b>Plus</b>
                </span>
            </div>
            @* 오른쪽: 사이트 홈(새 탭) · 알림 · 메시지(안 읽은 수 뱃지, 누르면 최근 안 읽은 목록 드롭다운 + 항목별 확인) *@
            <div class="right">
                <a href="/" target="_blank" rel="noopener" title="@this.Lang("SiteHome")"><i class="fi fiHome"></i></a>
                <div data-kind="notice">
                    <span role="button" tabindex="0" title="@this.Lang("Notification")"><i class="fi fiAlert"></i><b hidden="@(unreadNotice == 0)">@unreadNotice</b></span>
                    <section class="dropBox right">
                        <header><a href="/user/notice" target="_blank">@this.Lang("Notification")</a></header>
                        <ul></ul>
                    </section>
                </div>
                <div data-kind="message">
                    <span role="button" tabindex="0" title="@this.Lang("Message")"><i class="fi fiComments"></i><b hidden="@(unreadMessage == 0)">@unreadMessage</b></span>
                    <section class="dropBox right">
                        <header><a href="/user/message" target="_blank">@this.Lang("Message")</a></header>
                        <ul></ul>
                    </section>
                </div>
            </div>
        </header>

        <main class="@this.AppClass">
            <header>
                <div class="left">
                    <span>@this.Title</span>
                    @if (!string.IsNullOrEmpty(this.Description))
                    {
                        <small>@this.Description</small>
                    }
                </div>
            </header>
            <section>
                @RenderBody()
            </section>
        </main>
    </article>
    <partial name="_SitePopup" model="BitPlus.Data.Content.PopupArea.Manager" /> @* 사이트 팝업 — 관리자 화면 영역 *@
</div>

