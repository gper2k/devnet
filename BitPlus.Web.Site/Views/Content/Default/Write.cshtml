@model ContentPageModel
@{
    // 규칙 설정(게시판 설정)의 카테고리·기능 옵션에 맞춰 화면 구성이 달라진다
    var isSurvey = Model.Type == BitPlus.Data.Content.ContentTypes.Survey; // 설문: 에디터 대신 설문 편집기, 게시 기간·대상은 "설문 기간"·"설문 대상자"
    var useNotice = Model.Option("UseNotice");
    var usePrivate = Model.Option("UsePrivate"); // 비공개 옵션 게시판: 글마다 비공개 체크 상자 (체크한 글만 관리자·글쓴이에게만 보임)
    var useTags = Model.Option("UseTags");
    var useLinks = Model.Option("UseRelatedLinks");
    var usePeriod = Model.Option("WriterPeriod");
    var useTarget = Model.Option("WriterTarget");
    var useMore = useLinks || usePeriod || useTarget; // 더보기 메뉴는 쓸 항목이 하나라도 있을 때만
    var isEdit = Model.EditNo > 0; // 글 번호(?no=)가 있으면 수정: 기존 글을 API 로 불러와 채운 뒤에 폼을 보여 준다
    // 다국어 게시판(본문이 에디터 HTML 인 형식): 게시된 글을 수정할 때 원문 + 언어별 번역 탭 (번역은 게시한 뒤에 붙임)
    var useTranslation = isEdit && Model.Option(BitPlus.Web.Data.Content.TranslationReader.OptionKey) && Model.Type is BitPlus.Data.Content.ContentTypes.Default or BitPlus.Data.Content.ContentTypes.Gallery or BitPlus.Data.Content.ContentTypes.Forum or BitPlus.Data.Content.ContentTypes.Blog or BitPlus.Data.Content.ContentTypes.Manual;
}

@* 일반 형식의 글쓰기(/content/{규칙}/write) — 쓰기 권한이 있는 사용자만 열린다(컨트롤러 검사). 구성은 규칙 설정에 따라 달라지며(카테고리 선택, 공지 체크, 제목 옆 더보기 메뉴: 연관 링크 입력줄 추가·게시 기간 모달·게시 대상 모달, 태그 입력), 저장은 api/content/post 로 한다(글 번호 ?no= 가 있으면 수정: 기존 글을 불러와 채움, 비회원은 비밀번호로 본인 확인). *@
<article class="contentWrite flexCol">
    @if (string.IsNullOrEmpty(Model.TopHtml))
    {
    <header>
        <span>
            @Model.Title
            <small>
                @this.Lang(Model.Type == BitPlus.Data.Content.ContentTypes.Manual ? (Model.ReplyNo > 0 ? "ManualNewPage" : "ManualNewGroup") : Model.ReplyNo > 0 ? "Answer" : Model.Type == BitPlus.Data.Content.ContentTypes.Forum ? "NewTopic" : "ContentWrite")
            </small>
        </span>
    </header>
    }
    @if (isEdit && Model.NeedPassword)
    {
        <section class="gate">
            <p>@this.Lang("PostPasswordNeeded")</p>
            <div>
                <input type="password" name="gatePassword" maxlength="64" autocomplete="off" placeholder="@this.Lang("Password")" />
                <button type="button" class="main" id="contentGateBtn"><i class="fi fiCheckmark"></i> @this.Lang("Confirm")</button>
            </div>
        </section>
    }
    @if (useTranslation)
    {
        @* 언어 탭: 원문 + 번역 언어 + 번역 추가 (글을 불러온 뒤 게시된 글이면 나타남). 번역 탭에서는 제목·본문만 그 언어로 고치고 저장도 그 언어만 *@
        <nav class="tabBox" data-section="langs" hidden><header></header></nav>
    }
    <ul class="form auto" @(isEdit ? "hidden" : null)>
        <li class="row">
            <header class="fix">
                <span>@this.Lang("ContentTitle")</span>
            </header>
            <div class="title">
                <div class="inputGroup">
                    <input type="text" name="title" maxlength="512" autocomplete="off" />
                    @if (useMore)
                    {
                        <button type="button" id="contentMoreBtn" class="deco"><i class="fi fiEllipsisV"></i></button>
                    }
                </div>
                <div class="checkGroup">
                    @if (useNotice && Model.Permission.IsAdmin && Model.ReplyNo == 0) // 답글은 공지로 올릴 수 없음
                    {
                        <label class="check main"><input type="checkbox" name="isNotice" /><span>@this.Lang("Notice")</span></label>
                    }
                    @if (usePrivate)
                    {
                        <label class="check"><input type="checkbox" name="isPrivate" /><span>@this.Lang("ContentPrivate")</span></label>
                    }
                </div>
            </div>
        </li>
        @if (Model.Categories.Count > 0 && !(Model.Type == BitPlus.Data.Content.ContentTypes.Manual && Model.ReplyNo > 0)) // 메뉴얼 페이지의 카테고리는 소속 그룹을 따름
        {
            <li class="col2 row">
                <div>
                    <header class="fix">@this.Lang("ContentCategory")</header>
                    <div class="category">
                        <select name="category">
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Key">@category.Value</option>
                            }
                        </select>
                    </div>
                </div>
                <div>
                </div>
            </li>
        }
        @if (useLinks)
        {
            <li class="row" data-section="links" hidden>
                <header class="fix">@this.Lang("RelatedLink")</header>
                <ul class="links"></ul>
            </li>
        }
        <li class="body">
            @if (isSurvey)
            {
                <partial name="~/Views/Content/Survey/Editor.cshtml" model="Model" />
            }
            else
            {
                <textarea name="body"></textarea>
            }
        </li>
        <li class="row" data-section="files" hidden>
            <header class="fix">
                <span>@this.Lang("ContentFiles")</span>
            </header>
            <div>
                <div>
                    <button type="button"><i class="fi fiAttach"></i> @this.Lang("FileSelect")</button>
                    <small></small>
                    <input type="file" multiple hidden />
                </div>
                <ul></ul>
            </div>
        </li>
        @if (useTags)
        {
            <li class="row">
                <header class="fix">@this.Lang("Tag")</header>
                <ul class="tags"><li><input type="text" name="tag" maxlength="64" autocomplete="off" /></li></ul>
            </li>
        }
        @if (Model.NeedPassword)
        {
            <li class="row" data-section="password">
                <header class="fix">@this.Lang("Password")</header>
                <div><input type="password" name="password" maxlength="64" autocomplete="new-password" /></div>
            </li>
        }
    </ul>
    <footer>
        <a class="btn" href="javascript: history.back()"><i class="fi fiBan"></i> @this.Lang("Cancel")</a>
        <button type="button" id="contentDraftBtn" @(isEdit ? "hidden" : null)><i class="fi fiSaveEdit"></i> @this.Lang("SaveDraft")</button>
        <button type="button" class="main" id="contentSaveBtn" @(isEdit ? "hidden" : null)><i class="fi fiSend"></i> @this.Lang("PostPublish")</button>
    </footer>
</article>
<script>
    window.addEventListener('DOMContentLoaded', async () => {
        const root = document.querySelector('article.contentWrite');
        const replyNo = @Model.ReplyNo; // 답글이면 원본 글 번호 (저장할 때 replyTo 로 보내 원본글 묶음·깊이·순서를 정하게 함)
        const ruleNo = @Model.RuleNo, editNo = @Model.EditNo, guest = @(Model.NeedPassword ? "true" : "false");
        const field = name => root.querySelector(`[name="${name}"]`);
        const form = root.querySelector('ul.form'), saveBtn = root.querySelector('#contentSaveBtn'), draftBtn = root.querySelector('#contentDraftBtn'), tagsBox = root.querySelector('ul.tags');

        // 글 설정 상태 (저장 때 그대로 보낸다): 게시 기간(UTC ISO), 게시 대상(읽기 권한)
        const state = { period: { start: null, end: null }, targets: [] };

        // 수정: 기존 글을 불러온다 (본인 글 확인은 서버가 한다: 회원 글은 작성자 본인, 비회원 글은 비밀번호). 불러올 수 없으면 오류 알림만 뜨고 폼은 열리지 않는다.
        const loadPost = async password => {
            const res = await common.postSend('/api/content/post/load', common.makeFormData({ ruleNo, contentNo: editNo, password }));
            return res && res.success ? res.data : null;
        };
        let post = null, ownerKey = crypto.randomUUID(); // 새 글: 작성 중 에디터 이미지의 임시 소유자 키 (저장 때 글 식별키로 이전)
        if (editNo) {
            if (guest) {
                const gateBtn = root.querySelector('#contentGateBtn'), gateInput = field('gatePassword');
                const saved = (() => { try { const k = `contentPw_${ruleNo}_${editNo}`, v = sessionStorage.getItem(k); sessionStorage.removeItem(k); return v; } catch { return null; } })(); // 보기 화면에서 확인한 비밀번호 (한 번만 넘어옴)
                const auto = saved ? await loadPost(saved) : null;
                if (auto) {
                    field('password').value = saved; // 저장 때 본인 확인용으로 함께 보낸다
                    root.querySelector('section.gate').hidden = true;
                    post = auto;
                } else post = await new Promise(resolve => {
                    const open = async () => {
                        const data = await loadPost(gateInput.value);
                        if (!data) return;
                        field('password').value = gateInput.value; // 저장 때 본인 확인용으로 함께 보낸다
                        root.querySelector('section.gate').hidden = true;
                        resolve(data);
                    };
                    gateBtn.onclick = open;
                    gateInput.onkeydown = e => { if (e.key === 'Enter') open(); };
                });
            } else {
                post = await loadPost('');
                if (!post) return;
            }
            form.hidden = false;
            // 이미 게시된 글은 저장 한 개(게시 유지), 임시 저장 글은 임시 저장·게시 두 개
            saveBtn.hidden = false;
            if (post.published) saveBtn.innerHTML = '<i class="fi fiSave"></i> ' + @this.Js(this.Lang("Save"));
            else draftBtn.hidden = false;
            ownerKey = post.id;
        }

        // 새 글: 이전에 쓰던 임시 글이 있으면 그대로 불러와 이어 쓴다 (임시 글은 처음 저장·파일 업로드 때 서버가 만든다). 회원은 서버가 본인 임시 글을 찾고,
        // 비회원은 브라우저에 보관한 임시 글 식별키로만 찾으며(12시간 지나면 서버가 지움) 식별키는 게시하면 버린다.
        const draftStore = `contentDraft_${ruleNo}_${replyNo}`;
        const keepDraftKey = key => { if (guest) try { key ? localStorage.setItem(draftStore, key) : localStorage.removeItem(draftStore); } catch { } };
        if (!editNo) {
            let stored = null;
            if (guest) try { stored = localStorage.getItem(draftStore); } catch { }
            const found = (await common.postSend('/api/content/draft', common.makeFormData({ ruleNo, replyTo: replyNo || null, draftKey: stored }), { useLoading: false }))?.data;
            if (found?.id) { post = found; ownerKey = found.id; }
            keepDraftKey(ownerKey);
        }

        const editorOption = { ownerType: '@BitPlus.Web.Data.Content.DefaultContentHandler.PostOwnerType', ownerKey, siteCss: true, get password() { return field('password')?.value; } };
        const editor = @(isSurvey ? Html.Raw("window.makeSurveyEditor(root.querySelector('#surveyEditor'), post?.participants ?? 0)") : Html.Raw("await common.makeEditor(field('body'), editorOption)")); // 높이 기본 100%: 남는 높이를 에디터가 채움 (article.flexCol > ul.form.auto > li.editorFill)
        const section = name => root.querySelector(`[data-section="${name}"]`);
        const menu = [];

        @if (useLinks)
        {
            <text>
        // 연관 링크: 메뉴를 누를 때마다 링크 입력칸이 한 줄 추가되고 줄마다 삭제 버튼이 있다
        const links = section('links');
        const addLink = (value = '') => {
            links.hidden = false;
            const li = document.createElement('li');
            li.innerHTML = '<div class="inputGroup"><input type="url" name="link" maxlength="1024" autocomplete="off" placeholder="https://" /><button type="button" class="danger"><i class="fi fiDismiss"></i></button></div>';
            li.querySelector('input').value = value;
            links.querySelector('ul').appendChild(li);
            return li;
        };
        menu.push({ text: @this.Js(this.Lang("RelatedLink")), icon: 'fi fiLink', action: () => addLink().querySelector('input').focus() });
        (post?.links ?? []).forEach(addLink); // 수정: 저장돼 있던 연관 링크
        links.querySelector('ul').onclick = e => {
            if (!e.target.closest('button')) return;
            e.target.closest('li').remove();
            if (!links.querySelector('ul > li')) links.hidden = true;
        };
            </text>
        }
        @if (usePeriod)
        {
            <text>
        // 게시 기간: 시작~종료일 설정 모달(periodEdit)에서만 다룬다 (정한 값은 state.period 에 보관, 다시 열면 그 값으로 열림)
        menu.push({
            text: @this.Js(this.Lang(isSurvey ? "SurveyPeriod" : "PublishPeriod")), icon: 'fi fiCalClock', action: async () => {
                const result = await common.periodEdit(state.period.start, state.period.end, @(isSurvey ? Html.Raw("{ title: " + this.Js(this.Lang("SurveyPeriod")) + ", startLabel: " + this.Js(this.Lang("SurveyPeriodStart")) + ", endLabel: " + this.Js(this.Lang("SurveyPeriodEnd")) + ", info: '' }") : Html.Raw("undefined")));
                if (result) Object.assign(state.period, result);
            }
        });
            </text>
        }
        @if (useTarget)
        {
            <text>
        // 게시 대상: 공용 대상 편집 모달(targetEdit: 역할/그룹/그룹(자식 포함)/사용자 선택, 항목 삭제)에서만 다룬다 (정한 값은 state.targets 에 보관, 다시 열면 그 값으로 열림). 모두 읽기 권한이라 권한별 체크 상자는 없다.
        menu.push({
            text: @this.Js(this.Lang(isSurvey ? "SurveyTarget" : "PublishTarget")), icon: 'fi fiShieldKeyhole', action: async () => {
                const result = await common.modal.append('targetEdit', { title: @this.Js(this.Lang(isSurvey ? "SurveyTarget" : "PublishTarget")), items: state.targets });
                if (result) state.targets = result;
            }
        });
            </text>
        }

        // 첨부 파일: 게시판 설정의 파일 규칙(확장자·개수·용량·업로드 권한)을 읽어 업로드 UI 를 연다 (규칙이 없거나 업로드 권한이 없으면 구역이 나타나지 않는다).
        // 올리는 즉시 파일마다 전송하고(진행률 표시), 이번 작성에서 올린 파일을 지우면 바로 지운다. 이미 글에 등록된 파일은 저장할 때 removeFiles 로 함께 보내 지운다.
        const files = (post?.files ?? []).map(p => ({ ...p, state: 'done', percent: 100, registered: true })); // { id, name, size, state: uploading|done|error, percent, text, registered, file, ctrl }
        const removed = []; // 저장할 때 지울 등록된 파일 식별키
        const filesBox = section('files'), fileList = filesBox.querySelector('ul'), fileInput = filesBox.querySelector('input[type="file"]');
        const fileRule = (await common.getSend(`/api/content/file?ruleNo=${ruleNo}`, { useLoading: false }))?.data;
        const fileOwner = () => editNo ? { contentNo: editNo, password: field('password')?.value ?? '' } : { draftKey: ownerKey, replyTo: replyNo || null }; // 올릴 곳: 수정은 글, 새 글은 임시 글
        const fileText = f => f.state === 'done' ? @this.Js(this.Lang("FileUploadDone")) : f.state === 'error' ? f.text : f.percent + '%'; // 전송 상태 글자
        const paintFile = f => { // 항목의 진행률·상태만 갱신 (목록을 다시 그리지 않음)
            const li = fileList.children[files.indexOf(f)];
            if (!li) return;
            li.dataset.state = f.state;
            li.querySelector('progress').value = f.percent;
            li.querySelector('em').textContent = fileText(f);
        };
        const bindFiles = () => common.bindList(fileList, files, f => common.html`
            <li data-state="${f.state}">
                <span title="${f.name}">${f.name}</span>
                <div><progress max="100" value="${f.percent}"></progress><em>${fileText(f)}</em></div>
                <small>${common.fileSizeText(f.size)}</small>
                <button type="button" class="danger"><i class="fi fiDismiss"></i></button>
            </li>`);
        const uploadFile = async f => {
            f.ctrl = new AbortController();
            const res = await common.uploadFile('/api/content/file', f.file, { ruleNo, removeFiles: JSON.stringify(removed), ...fileOwner() }, percent => { f.percent = percent; paintFile(f); }, f.ctrl.signal); // 5MB 를 넘으면 조각 업로드(최대 2GB)
            if (f.ctrl.signal.aborted) return; // 지우기로 취소됨
            if (res?.success) Object.assign(f, { id: res.data[0].id, state: 'done', percent: 100, file: null });
            else Object.assign(f, { state: 'error', text: res?.message ?? @this.Js(this.Lang("FileUploadFailed")) });
            paintFile(f);
        };
        if (fileRule?.enabled && fileRule.canUpload) {
            filesBox.hidden = false;
            const limit = [fileRule.extensions.length ? `${@this.Js(this.Lang("AllowExtensions"))}: ${fileRule.extensions.join(', ')}` : '', fileRule.count > 0 ? `${@this.Js(this.Lang("AllowCount"))}: ${fileRule.count}` : '',
                fileRule.size > 0 ? `${@this.Js(this.Lang("AllowSize"))}: ${common.fileSizeText(fileRule.size)}` : '', fileRule.totalSize > 0 ? `${@this.Js(this.Lang("AllowTotalSize"))}: ${common.fileSizeText(fileRule.totalSize)}` : ''].filter(Boolean);
            filesBox.querySelector('small').textContent = limit.join(' · ');
            if (fileRule.extensions.length) fileInput.accept = fileRule.extensions.map(e => '.' + e).join(','); // 파일 선택 창은 허용 확장자만 보여 줌
            filesBox.querySelector('button').onclick = () => fileInput.click();
            fileInput.onchange = async () => {
                const picked = [...fileInput.files];
                fileInput.value = '';
                // 서버가 같은 검사를 하지만, 큰 파일을 올리기 전에 먼저 알려 준다: 하나라도 어긋나면 아무것도 올리지 않는다
                let count = files.length, total = files.reduce((sum, p) => sum + p.size, 0);
                for (const file of picked) {
                    const ext = file.name.includes('.') ? file.name.split('.').pop().toLowerCase() : '';
                    if (fileRule.extensions.length && !fileRule.extensions.includes(ext)) return common.alert(@(this.Js(this.Lang("FileTypeNotAllowed"))).replace('{0}', file.name));
                    if (fileRule.size > 0 && file.size > fileRule.size) return common.alert(@(this.Js(this.Lang("FileSizeOver"))).replace('{0}', file.name));
                    count++; total += file.size;
                }
                if (fileRule.count > 0 && count > fileRule.count) return common.alert(@(this.Js(this.Lang("FileCountOver"))).replace('{0}', fileRule.count));
                if (fileRule.totalSize > 0 && total > fileRule.totalSize) return common.alert(@this.Js(this.Lang("FileTotalSizeOver")));

                const added = picked.map(file => ({ id: null, name: file.name, size: file.size, state: 'uploading', percent: 0, registered: false, file }));
                files.push(...added);
                bindFiles();
                for (const f of added) if (files.includes(f)) await uploadFile(f); // 하나씩 차례로 올린다 (개수·용량 검사가 서로 엇갈리지 않게)
            };
            fileList.onclick = async e => {
                if (!e.target.closest('button')) return;
                const f = files[[...fileList.children].indexOf(e.target.closest('li'))];
                if (f.state === 'uploading') f.ctrl?.abort();
                else if (f.registered) removed.push(f.id);
                else if (f.state === 'done') {
                    const res = await common.postSend('/api/content/file/delete', common.makeFormData({ ruleNo, fileId: f.id, ...fileOwner() }), { useLoading: false });
                    if (!res?.success) return;
                }
                files.splice(files.indexOf(f), 1);
                bindFiles();
            };
            bindFiles();
        }

        const isManual = @(Model.Type == BitPlus.Data.Content.ContentTypes.Manual ? "true" : "false");
        if (replyNo && !editNo && !isManual) field('title').value = 'RE: ' + @this.Js(Model.ReplyTitle); // 답글 제목 기본값 (메뉴얼 페이지는 제목을 새로 씀)

        // 수정: 불러온 글의 값을 채운다 (본문은 에디터에, 태그는 태그 입력에)
        if (post) {
            if (post.title) field('title').value = post.title;
            if (field('category') && post.category) field('category').value = post.category;
            if (post.isReply) field('isNotice')?.closest('label').remove(); // 답글은 공지로 올릴 수 없음
            if (post.isReply && isManual) field('category')?.closest('li').remove(); // 메뉴얼 페이지의 카테고리는 소속 그룹을 따름
            if (field('isNotice')) field('isNotice').checked = post.isNotice;
            if (field('isNotice') && @(BitPlus.Web.Data.Content.ForumContentHandler.UsesTopicComments(Model.Type) ? "true" : "false")) field('isNotice').disabled = !!editNo; // 포럼: 공지 여부는 등록할 때만 정함 (서버도 막음)
            if (field('isPrivate')) { field('isPrivate').checked = post.options?.isPrivate === 'true'; field('isPrivate').disabled = !!editNo; } // 비공개 선택은 등록할 때만, 수정에서는 바꿀 수 없음 (임시 글은 아직 등록 전이라 바꿀 수 있음)
            state.period = { start: post.start, end: post.end };
            state.targets = post.targets;
            if (tagsBox) common.setTags(tagsBox, post.tags);
            editor.setHtml(post.body);
        }

        // 저장: 새 글은 임시 글(draftKey = 임시 글 식별키)을 저장하거나 게시(게시할 때 글 번호가 붙음), 수정은 글 번호(contentNo)로 저장. 항목별 반영 여부와 검증은 서버가 규칙 옵션에 따라 처리한다.
        // published: 게시는 true, 임시 저장은 false (Published 컬럼, 임시 저장 글은 목록에 나오지 않는다)
        const save = async published => {
            if (files.some(f => f.state === 'uploading')) return common.alert(@this.Js(this.Lang("FileUploading")));
            const body = {
                removeFiles: JSON.stringify(removed),
                title: field('title').value.trim(), body: editor.getHtml(), category: field('category')?.value ?? '', isNotice: field('isNotice')?.checked ?? false,
                links: JSON.stringify([...root.querySelectorAll('[data-section="links"] input[name="link"]')].map(p => p.value.trim()).filter(Boolean)),
                start: state.period.start ?? '', end: state.period.end ?? '', targets: JSON.stringify(state.targets.map(p => ({ type: p.type, key: p.key }))),
                tags: JSON.stringify(tagsBox ? common.getTags(tagsBox) : []),
                password: field('password')?.value ?? '', published,
                ...(replyNo && !editNo ? { replyTo: replyNo } : {}),
                ...(field('isPrivate')?.checked ? { isPrivate: true } : {}) // 정해진 필드가 아닌 값은 서버가 글 속성 options 에 모아 저장
            };
            // 글 저장은 새 글/수정 모두 한 API: 글 번호(contentNo)가 있으면 수정, 없으면 새 글 (새 글은 임시 글 식별키 draftKey 를 함께 보냄)
            const res = await common.postSend('/api/content/post', common.makeFormData(editNo ? { ...body, ruleNo, contentNo: editNo } : { ...body, ruleNo, draftKey: ownerKey }));
            if (!res?.success) return;
            if (!res.data.url) return; // 임시 저장: 화면에 남아 계속 쓴다
            keepDraftKey(null);
            location.href = res.data.url;
        };
        saveBtn.onclick = () => save(true);
        draftBtn.onclick = () => save(false);
        @if (useTranslation)
        {
            <text>
        // 다국어: 원문 + 번역 언어 탭. 탭을 바꾸면 제목·본문만 그 언어 값으로 바꿔 보이고(카테고리·첨부·태그 등 다른 항목은 원문에만 있어 번역 탭에서는 숨김),
        // 저장은 지금 탭의 언어만 저장한다 (원문은 위의 글 저장, 번역은 api/content/post/translation — 제목·본문을 모두 비우거나 탭의 삭제를 누르면 그 번역 삭제).
        const translations = post?.published ? (await common.postSend('/api/content/post/translation/load', common.makeFormData({ ruleNo, contentNo: editNo, password: field('password')?.value ?? '' }), { useLoading: false }))?.data : null;
        if (translations) {
            const langBox = root.querySelector('[data-section="langs"]'), langHead = langBox.querySelector('header');
            const names = (await common.getSend('/api/system/langinput', { useLoading: false }))?.data?.cultures ?? {}; // 지원 문화권 (코드 → 언어 이름)
            const tabs = [{ culture: translations.culture, original: true }, ...translations.items];
            let active = tabs[0];
            const keep = () => Object.assign(active, { title: field('title').value, body: editor.getHtml() }); // 탭을 떠날 때 지금 탭의 입력 보관
            const show = tab => {
                keep();
                active = tab;
                field('title').value = tab.title ?? '';
                editor.setHtml(tab.body ?? '');
                form.toggleAttribute('data-translation', !tab.original); // 번역 탭: 제목·본문 줄만 보임 (스타일)
                paint();
            };
            const icon = name => { const i = document.createElement('i'); i.className = 'fi ' + name; return i; };
            const paint = () => {
                langHead.replaceChildren(...tabs.map(tab => {
                    const span = document.createElement('span');
                    span.className = tab === active ? 'active' : '';
                    span.append((names[tab.culture] ?? tab.culture) + (tab.original ? ' · ' + @this.Js(this.Lang("Original")) : ''));
                    if (tab.isMachine) span.append(' ', icon('fiSparkle'));
                    if (tab.outdated) { span.append(' ', icon('fiWarning')); span.title = @this.Js(this.Lang("TranslationOutdated")); }
                    if (tab === active && !tab.original && tab.saved !== false) { const del = icon('fiDismiss'); del.dataset.remove = ''; span.append(' ', del); } // 저장된 번역 삭제
                    span.onclick = e => e.target.closest('[data-remove]') ? remove(tab) : tab !== active && show(tab);
                    return span;
                }), (() => {
                    const add = document.createElement('span');
                    add.append(icon('fiPlus'),' ', @this.Js(this.LangOf("AddOf", "Translation")));
                    add.onclick = e => {
                        const free = Object.keys(names).filter(c => !tabs.some(t => t.culture.toLowerCase() === c.toLowerCase()));
                        common.popMenu(e.currentTarget, free.map(c => ({ text: names[c], icon: 'fi fiLocalLanguage', action: () => { keep(); const tab = { culture: c, title: tabs[0].title, body: tabs[0].body, saved: false }; tabs.push(tab); show(tab); } }))); // 새 번역은 원문을 그대로 옮겨 놓고 고침
                    };
                    return add;
                })());
                langHead.lastChild.hidden = tabs.length >= Object.keys(names).length; // text 블록 안의 작다 기호는 Razor 가 태그로 읽어 CSS 격리 속성을 끼워 넣으므로 쓰지 않음
            };
            const saveTranslation = async (title, body) => common.postSend('/api/content/post/translation', common.makeFormData({ ruleNo, contentNo: editNo, culture: active.culture, title, body, password: field('password')?.value ?? '' }));
            const remove = async tab => {
                if (!await common.confirm(@this.Js(this.LangOf("DelMsg", "Translation")))) return;
                if (!(await saveTranslation('', ''))?.success) return;
                tabs.splice(tabs.indexOf(tab), 1);
                active = tabs[0];
                field('title').value = active.title; editor.setHtml(active.body);
                form.removeAttribute('data-translation');
                paint();
            };
            saveBtn.onclick = async () => {
                if (active.original) return save(true);
                const res = await saveTranslation(field('title').value.trim(), editor.getHtml());
                if (res?.success) location.href = `/content/${ruleNo}/view/${editNo}?lang=${encodeURIComponent(active.culture)}`; // 저장한 번역으로 글 보기
            };
            keep();
            langBox.hidden = false;
            paint();
        }
            </text>
        }

        // 더보기 메뉴: 위 항목 중 쓸 수 있는 것만 담기고, 하나도 없으면 버튼 자체가 그려지지 않는다
        const more = root.querySelector('#contentMoreBtn');
        if (more) more.onclick = e => common.popMenu(e.currentTarget, menu, 'right'); // 제목 끝 버튼이라 메뉴는 버튼 우측 끝 기준으로 왼쪽으로 펼침
    });
</script>
