@model ContentPageModel
@{
    // 목록에서 넘어온 목록 상태 쿼리(page, size, q, category, pending)를 비밀번호 확인 후 글 보기·목록 버튼에도 이어 붙인다 (이전 목록 환경으로 돌아가기)
    var listQuery = QueryString.Create(new[] { "page", "size", "q", "category", "pending" }.Where(k => !string.IsNullOrEmpty(this.Context.Request.Query[k])).Select(k => new KeyValuePair<string, string?>(k, this.Context.Request.Query[k].ToString()))).ToString();
}

@* 비회원이 쓴 글(작성자 정보 없이 비밀번호만 있는 글)이 평소 조건으로는 읽을 수 없을 때, 글을 쓸 때 입력한 비밀번호를 받아 맞으면 본인 글로 보여 주는 화면(같은 글 주소로 POST). *@
<article class="postPassword">
    <form method="post" action="/content/@Model.RuleNo/view/@Model.PostNo@listQuery">
        <small>@Model.Title</small>
        <i class="fi fiLock"></i>
        <p>@this.Lang("PostPasswordNeeded")</p>
        @if (ViewData["PasswordFailed"] is true)
        {
            <strong>@this.Lang("PostPasswordInvalid")</strong>
        }
        <strong hidden id="contentPasswordLocked">@this.Lang("PostPasswordLocked")</strong>
        <div>
            <input type="password" name="password" maxlength="64" autocomplete="off" autofocus placeholder="@this.Lang("Password")" />
            <button type="submit" class="main"><i class="fi fiCheckmark"></i> @this.Lang("Confirm")</button>
        </div>
        <a href="/content/@Model.RuleNo@listQuery"><i class="fi fiList"></i> @this.Lang("ContentList")</a>
    </form>
</article>
<script>
    // 비밀번호 시도 제한: 서버 자원을 쓰지 않고 브라우저(localStorage)에서만 처리한다 (연속 5번 틀리면 10분간 이 글의 입력을 막음 — 쉽게 읽을 수 없는 정도의 보호).
    // 저장은 게시판 하나에 키 하나(contentRule_{게시판번호})만 쓰고, 값은 "글번호:틀린횟수,마지막시각" 항목을 ";" 로 이은 문자열이며 오래된 항목부터 지워 10건 안팎만 유지한다.
    window.addEventListener('DOMContentLoaded', () => {
        const form = document.querySelector('article.postPassword > form');
        const key = 'contentRule_@Model.RuleNo', no = '@Model.PostNo';
        const limit = 5, blockMs = 10 * 60 * 1000, keep = 10;
        const load = () => { try { return (localStorage.getItem(key) || '').split(';').filter(Boolean).map(p => { const [k, v] = p.split(':'); const [n, t] = (v || '').split(','); return { no: k, n: Number(n) || 0, t: Number(t) || 0 }; }); } catch { return []; } };
        const save = list => { try { localStorage.setItem(key, list.slice(-keep).map(p => `${p.no}:${p.n},${p.t}`).join(';')); } catch { } };
        let list = load().filter(p => Date.now() - p.t < blockMs); // 막힌 시간이 지난 항목은 정리
        let state = list.find(p => p.no === no) ?? { no, n: 0, t: 0 };
        if (@(ViewData["PasswordFailed"] is true ? "true" : "false")) { // 방금 틀린 시도: 횟수를 올리고 가장 최근 항목으로 옮긴다
            state = { no, n: state.n + 1, t: Date.now() };
            list = [...list.filter(p => p.no !== no), state];
        }
        save(list);
        const locked = () => state.n >= limit && Date.now() - state.t < blockMs;
        const apply = () => {
            document.getElementById('contentPasswordLocked').hidden = !locked();
            form.querySelectorAll('input, button').forEach(el => el.disabled = locked());
        };
        form.addEventListener('submit', e => { if (locked()) e.preventDefault(); });
        apply();
    });
</script>
