@model ContentPageModel

@* FAQ형 목록(/content/{규칙}, /content/{규칙}/list) — 보기 페이지 없이 질문(Q)·답변(A) 카드만 보여 준다. 맨 위에 게시판 제목(가운데), 검색바, 그 아래 카테고리 목록(전체 + 카테고리, 누르면 그 카테고리만),
   그 아래 카드(최신 갱신순). 글쓴이·관리자에게는 카드 아래 오른쪽에 수정·삭제가 보인다. 목록은 api/content/list(FaqContentHandler)에서 받아 그리고 검색어·카테고리·쪽·크기는 주소 쿼리로 유지한다.
   답변은 서버가 글자를 HTML 로 바꿔 저장한 값(HTML 기호는 글자, 줄바꿈은 br)이라 카드 안에 그대로 넣는다. *@
<article class="contentFaq">
    <header>
        @if (string.IsNullOrEmpty(Model.TopHtml))
        {
            <h1>@Model.Title</h1>
        }
        <form id="faqSearch">
            <div class="inputGroup inline">
                <input type="search" name="q" maxlength="100" autocomplete="off" placeholder="@this.Lang("Search")" />
                <button type="submit" class="deco"><i class="fi fiSearch"></i></button>
            </div>
        </form>
        @if (Model.Categories.Count > 0)
        {
            <ul class="faqCategory" id="faqCategory">
                <li><span role="button" tabindex="0" data-val="" class="active">@this.Lang("All")</span></li>
                @foreach (var category in Model.Categories)
                {
                    <li><span role="button" tabindex="0" data-val="@category.Key">@category.Value</span></li>
                }
            </ul>
        }
    </header>
    @if (Model.Permission.CanWrite)
    {
        <div class="faqBar">
            <button type="button" class="deco xs" onclick="location.href='/content/@Model.RuleNo/write'"><i class="fi fiAdd"></i> @this.Lang("FaqNew")</button>
        </div>
    }
    <ul class="faqList" id="faqList"></ul>
    <footer>
        <div>
            <div class="pageSize">
                <label>LIST SIZE</label>
                <select name="pageSize">
                    @foreach (var size in ContentPageModel.PageSizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>
        <div>
            <ul class="pager" id="contentPager"></ul>
        </div>
    </footer>
</article>
<script>
    window.addEventListener('DOMContentLoaded', () => {
        const root = document.querySelector('article.contentFaq');
        const ruleNo = @Model.RuleNo;
        const list = root.querySelector('#faqList'), form = root.querySelector('#faqSearch'), categoryBox = root.querySelector('#faqCategory');
        const sizeSelect = root.querySelector('select[name="pageSize"]');
        const text = { edit: @this.Js(this.Lang("Edit")), remove: @this.Js(this.Lang("Delete")), empty: @this.Js(this.Lang("DataEmpty")), deleteMsg: @this.Js(this.Lang("DeletePostMsg") + " " + this.Lang("DelWarning")) };
        const defaultSize = @ContentPageModel.PageSizes[0];

        // ── 상태: 검색어·카테고리·쪽·크기를 주소 쿼리로 유지 ──
        const params = new URLSearchParams(location.search);
        let pageSize = common.applyPageSize(sizeSelect);
        let category = params.get('category') ?? '';
        let page = 1;
        let byNo = new Map(); // 글번호 → 목록 항목 (카드의 data-no 로 찾음)

        const queryOf = pageNo => {
            const p = new URLSearchParams();
            if (pageNo > 1) p.set('page', pageNo);
            if (pageSize !== defaultSize) p.set('size', pageSize);
            if (form.q.value.trim()) p.set('q', form.q.value.trim());
            if (category) p.set('category', category);
            return p.size ? `?${p}` : '';
        };

        // ── 그리기: 카드 한 장 (Q: 질문, A: 답변) ──
        const cardOf = i => common.html`
            <li data-no="${i.contentNo}">
                <div class="q"><b>Q</b><strong>${i.title}</strong></div>
                <div class="a"><b>A</b><div class="body"></div></div>
                ${i.canEdit || i.canDelete ? common.html`
                <footer>
                    ${i.canEdit ? common.html`<span role="button" tabindex="0" data-act="edit">${text.edit}</span>` : ''}
                    ${i.canDelete ? common.html`<span role="button" tabindex="0" data-act="remove">${text.remove}</span>` : ''}
                </footer>` : ''}
            </li>`;
        const fillBodies = () => list.querySelectorAll('li[data-no]').forEach(li => { li.querySelector('.a .body').innerHTML = byNo.get(Number(li.dataset.no)).body; });

        /** 목록을 API 로 불러와 카드와 페이저를 다시 그린다 (pageNo: 1부터) */
        const load = async (pageNo = 1) => {
            const query = new URLSearchParams({ ruleNo, page: pageNo, size: pageSize, q: form.q.value.trim(), category });
            const res = await common.getSend(`/api/content/list?${query}`, { useLoading: false });
            if (!res?.success) return;
            const data = res.data;
            page = data.page;
            history.replaceState(null, '', location.pathname + queryOf(data.page));
            byNo = new Map(data.items.map(i => [i.contentNo, i]));
            common.bindList(list, data.items, cardOf, common.html`<li class="empty"><i class="fi fiAnimalDog"></i><br />${text.empty}</li>`);
            fillBodies();
            root.querySelector('#contentPager').replaceWith(common.makePager(data.page - 1, data.pageSize, data.pageCount * data.pageSize).then(p => load(p + 1)));
            root.querySelector('ul.pager').id = 'contentPager';
        };

        // ── 동작 ──
        const selectCategory = value => {
            category = value;
            categoryBox?.querySelectorAll('span').forEach(s => s.classList.toggle('active', s.dataset.val === value));
            load(1);
        };
        categoryBox?.addEventListener('click', e => { const s = e.target.closest('span[data-val]'); if (s) selectCategory(s.dataset.val); });
        categoryBox?.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.matches('span[data-val]')) e.target.click(); });
        form.onsubmit = e => { e.preventDefault(); load(1); };
        sizeSelect.addEventListener('change', () => { pageSize = Number(sizeSelect.value); load(1); });
        list.addEventListener('click', async e => {
            const act = e.target.closest('[data-act]');
            if (!act) return;
            const no = Number(act.closest('li[data-no]').dataset.no);
            if (act.dataset.act === 'edit') location.href = `/content/${ruleNo}/write?no=${no}`;
            else if (await common.confirm(text.deleteMsg)) {
                const r = await common.netSend('/api/content/post', { method: 'DELETE', body: common.makeFormData({ ruleNo, contentNo: no, password: '' }) });
                if (r?.success) load(page);
            }
        });
        list.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.matches('[data-act]')) e.target.click(); });

        // 주소의 쿼리로 상태 복원
        form.q.value = params.get('q') ?? '';
        if (categoryBox && ![...categoryBox.querySelectorAll('span')].some(s => s.dataset.val === category)) category = '';
        categoryBox?.querySelectorAll('span').forEach(s => s.classList.toggle('active', s.dataset.val === category));
        const size = Number(params.get('size'));
        if (size >= 1 && size <= 100) { pageSize = size; if ([...sizeSelect.options].some(o => Number(o.value) === size)) sizeSelect.value = size; }
        load(Number(params.get('page')) || 1);
    });
</script>
