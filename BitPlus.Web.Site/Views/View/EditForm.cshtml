@model ContentEditModel
@{
    // 돌아갈 화면: ViewData["ReturnUrl"] 이 있으면(관리자 콘솔 /Manager/Content/Page) 저장·취소·삭제 후 그 주소, 없으면(사용자 화면 /view/edit) 저장·취소는 보기 화면, 삭제는 홈
    var returnUrl = ViewData["ReturnUrl"] as string ?? string.Empty;
}

@* 보기 전용 컨텐츠 작성/수정 폼 — 사용자 화면(Edit.cshtml)과 관리자 콘솔(Manager/Content/Page.cshtml)이 같이 쓰는 파샬뷰. 파샬뷰라 섹션을 쓸 수 없어 스크립트를 본문에 둔다. *@
<article class="contentEdit flexCol">
    @if (!Model.IsNew)
    {
        @* 언어 탭: 원문 + 번역 언어 + 번역 추가 (번역을 불러온 뒤 나타남) *@
        <nav class="tabBox" data-section="langs" hidden><header></header></nav>
    }
    <ul class="form auto">
        <li class="row">
            @* 제목은 보기 화면(/view/{번호})의 페이지 제목으로만 쓰이고 본문에는 나오지 않는다 *@
            <header>@this.Lang("ContentTitle") <small class="txDanger">*</small></header>
            <div class="inputGroup">
                <input type="text" name="title" maxlength="512" autocomplete="off" value="@Model.Title" />
                <button type="button" id="contentMoreBtn" class="deco"><i class="fi fiEllipsisV"></i></button>
            </div>
        </li>
        <li class="editorFill">
            <textarea name="body">@Model.Body</textarea>
        </li>
    </ul>
    <footer class="flexRow center">
        @if (returnUrl.Length > 0 || !Model.IsNew)
        {
            <a class="btn" href="@(returnUrl.Length > 0 ? returnUrl : "/view/" + Model.ContentNo)"><i class="fi fiBan"></i> @this.Lang("Cancel")</a>
        }
        <button type="button" class="main" id="contentSaveBtn"><i class="fi fiSave"></i> @this.Lang("Save")</button>
    </footer>
</article>

<script>
    window.addEventListener('DOMContentLoaded', async () => {
        const isNew = @(Model.IsNew ? "true" : "false");
        const ownerKey = @this.Js(Model.OwnerKey);
        const returnUrl = @this.Js(returnUrl);
        const root = document.querySelector('article.contentEdit');
        const titleInput = root.querySelector('[name="title"]');
        const editor = await common.makeEditor(root.querySelector('[name="body"]'), {
            ownerType: 'content.view', ownerKey,
            siteCss: true, // 편집 영역에 사이트 스타일을 연결해 보기 화면과 같게 보이게 한다
            // 사이트 페이지 영역을 관리자가 관리하는 용도라 보안 처리는 최소화: 에디터의 걸러내기를 모두 끄고 코드 보기도 자유롭게 둔다 (보호는 관리자 정책 필터가 맡음)
            rawHtml: true
        });

        // 다국어(수정일 때, 보기 전용 페이지는 항상): 원문 + 번역 언어 탭 — 게시판 글쓰기(Content/Default/Write.cshtml)와 같은 방식. 번역 탭에서는 제목·본문만 그 언어 값으로 바꿔 보이고
        // ⋮ 메뉴(기간·읽기 권한·사이드 — 원문에만 있음)는 숨긴다. 저장은 지금 탭의 언어만 (번역은 api/content/post/translation, 탭의 ✕ 는 그 번역 삭제)
        const lang = { active: null, save: null };
        const moreBtn = root.querySelector('#contentMoreBtn');
        const translations = isNew ? null : (await common.postSend('/api/content/post/translation/load', common.makeFormData({ type: 'PageView', contentNo: @Model.ContentNo }), { useLoading: false }))?.data;
        if (translations) {
            const langBox = root.querySelector('[data-section="langs"]'), langHead = langBox.querySelector('header');
            const names = (await common.getSend('/api/system/langinput', { useLoading: false }))?.data?.cultures ?? {}; // 지원 문화권 (코드 → 언어 이름)
            const tabs = [{ culture: translations.culture, original: true }, ...translations.items];
            lang.active = tabs[0];
            const keep = () => Object.assign(lang.active, { title: titleInput.value, body: editor.getHtml() }); // 탭을 떠날 때 지금 탭의 입력 보관
            const show = tab => {
                keep();
                lang.active = tab;
                titleInput.value = tab.title ?? '';
                editor.setHtml(tab.body ?? '');
                moreBtn.hidden = !tab.original;
                paint();
            };
            const icon = name => { const i = document.createElement('i'); i.className = 'fi ' + name; return i; };
            const send = (title, body) => common.postSend('/api/content/post/translation', common.makeFormData({ type: 'PageView', contentNo: @Model.ContentNo, culture: lang.active.culture, title, body }));
            const remove = async tab => {
                if (!await common.confirm(@this.Js(this.LangOf("DelMsg", "Translation")))) return;
                if (!(await send('', ''))?.success) return;
                tabs.splice(tabs.indexOf(tab), 1);
                lang.active = tabs[0];
                titleInput.value = lang.active.title;
                editor.setHtml(lang.active.body);
                moreBtn.hidden = false;
                paint();
            };
            const paint = () => {
                langHead.replaceChildren(...tabs.map(tab => {
                    const span = document.createElement('span');
                    span.className = tab === lang.active ? 'active' : '';
                    span.append((names[tab.culture] ?? tab.culture) + (tab.original ? ' · ' + @this.Js(this.Lang("Original")) : ''));
                    if (tab.isMachine) span.append(' ', icon('fiSparkle'));
                    if (tab.outdated) { span.append(' ', icon('fiWarning')); span.title = @this.Js(this.Lang("TranslationOutdated")); }
                    if (tab === lang.active && !tab.original && tab.saved !== false) { const del = icon('fiDismiss'); del.dataset.remove = ''; span.append(' ', del); } // 저장된 번역 삭제
                    span.onclick = e => e.target.closest('[data-remove]') ? remove(tab) : tab !== lang.active && show(tab);
                    return span;
                }), (() => {
                    const add = document.createElement('span');
                    add.append(icon('fiPlus'), ' ', @this.Js(this.LangOf("AddOf", "Translation")));
                    add.onclick = e => {
                        const free = Object.keys(names).filter(c => !tabs.some(t => t.culture.toLowerCase() === c.toLowerCase()));
                        common.popMenu(e.currentTarget, free.map(c => ({ text: names[c], icon: 'fi fiLocalLanguage', action: () => { keep(); const tab = { culture: c, title: tabs[0].title, body: tabs[0].body, saved: false }; tabs.push(tab); show(tab); } }))); // 새 번역은 원문을 그대로 옮겨 놓고 고침
                    };
                    return add;
                })());
                langHead.lastChild.hidden = tabs.length >= Object.keys(names).length;
            };
            lang.save = async () => { // 번역 탭 저장: 저장한 언어로 보기 (관리자 콘솔이면 돌아갈 화면)
                const res = await send(titleInput.value.trim(), editor.getHtml());
                if (res?.success) location.href = returnUrl || `/view/@Model.ContentNo?lang=${encodeURIComponent(lang.active.culture)}`;
            };
            keep();
            langBox.hidden = false;
            paint();
        }

        // 게시 기간(start/end, UTC ISO)과 읽기 권한 대상(type/key/name) — 저장할 때 함께 보낸다. 수정이면 저장된 값을 불러온다.
        // 사이드 구성(sideHidden/sidePosition/sideMenuKey, 연결 메뉴 목록 sideMenus)도 같은 API 로 불러온다 (신규는 기본값: 감춤·좌측·자동)
        const settings = { start: null, end: null, readRules: [], sideHidden: true, sidePosition: 'Left', sideMenuKey: '', sideMenus: [] };
        common.postSend('/api/content/post/load', common.makeFormData({ type: 'PageView', contentNo: isNew ? 0 : @Model.ContentNo }), { useLoading: false }).then(res => { if (res && res.success) Object.assign(settings, res.data); });

        // 제목 옆 ⋮ 버튼: 기간 설정 / 읽기 권한 설정 / 사이드 구성 모달
        // 수정일 때만 "메뉴 추가"(공용 메뉴 편집 모달)와 "삭제": 메뉴 추가는 모달에 제목(현재 문화권 표시명), 보기 경로(/view/{글 번호}), 읽기 권한 대상(메뉴 접근 권한)을 미리 채운다
        const menuItems = isNew ? [] : [
            { divider: true },
            {
                text: @this.Js(this.LangOf("AddOf", "Menu")), icon: 'fi fiMenu', action: () => common.modal.append('menuEdit', {
                    values: { dpNames: { [common.culture]: root.querySelector('[name="title"]').value.trim() }, type: 'Move', action: '/view/@Model.ContentNo', accesses: settings.readRules }
                })
            },
            {
                text: @this.Js(this.Lang("Delete")), icon: 'fi fiDelete', danger: true, action: async () => {
                    if (!await common.confirm(@this.Js(this.LangOf("DelMsg", "ContentManage") + " " + this.Lang("DelWarning")))) return;
                    const res = await common.delSend('/api/content/post?type=PageView&contentNo=@Model.ContentNo');
                    if (res && res.success) location.href = returnUrl || '/';
                }
            }
        ];
        moreBtn.onclick = e => common.popMenu(e.currentTarget, [
            {
                text: @this.Js(this.Lang("PublishPeriod")), icon: 'fi fiCalClock', action: async () => {
                    const result = await common.periodEdit(settings.start, settings.end);
                    if (result) Object.assign(settings, result);
                }
            },
            {
                text: @this.Js(this.Lang("ReadPermission")), icon: 'fi fiShieldKeyhole', action: async () => {
                    const result = await common.modal.append('targetEdit', { title: @this.Js(this.Lang("ReadPermission")), items: settings.readRules });
                    if (result) settings.readRules = result;
                }
            },
            {
                text: @this.Js(this.Lang("SideConfig")), icon: 'fi fiPanelLeft', action: async () => {
                    const result = await common.modal.append('sideEdit', { hidden: settings.sideHidden, position: settings.sidePosition, menuKey: settings.sideMenuKey, menus: settings.sideMenus });
                    if (result) Object.assign(settings, { sideHidden: result.hidden, sidePosition: result.position, sideMenuKey: result.menuKey });
                }
            },
            ...menuItems
        ], 'right'); // 제목 끝 버튼이라 메뉴는 버튼 우측 끝 기준으로 왼쪽으로 펼침
        root.querySelector('#contentSaveBtn').onclick = async () => {
            if (lang.active && !lang.active.original) return lang.save();
            if (!titleInput.value.trim()) {
                titleInput.focus();
                return common.alert(@this.Js(this.LangOf("ValidRequired", "ContentTitle")));
            }
            const body = { title: titleInput.value.trim(), body: editor.getHtml(),
                start: settings.start ?? '', end: settings.end ?? '', readRules: JSON.stringify(settings.readRules.map(p => ({ type: p.type, key: p.key }))),
                sideHidden: settings.sideHidden, sidePosition: settings.sidePosition, sideMenuKey: settings.sideMenuKey };
            body.type = 'PageView'; // 글 저장은 새 글/수정 모두 한 API: 글 번호(contentNo)가 있으면 수정, 없으면 새 글
            if (isNew) body.draftKey = ownerKey; else body.contentNo = @Model.ContentNo;
            const res = await common.postSend('/api/content/post', common.makeFormData(body));
            if (res && res.success) location.href = returnUrl || res.data.url;
        };
    });
</script>
