@inherits BitPlus.Web.HTTP.View.ViewBase<dynamic>
@{
    Layout = null;
}
@* 공지 위젯 설정 — ruleNos(게시판, 비우면 전체), count(개수), image(대표 이미지 보이기) *@
<ul class="form">
    <partial name="~/Views/Widgets/_BoardSelect.cshtml" model="(BitPlus.Data.Content.ContentTypes[]?)null" />
    <li class="col2">
        <div>
            <header>@this.Lang("WidgetCount")</header>
            <input type="number" name="count" min="1" max="20" />
        </div>
        <div>
            <header>@this.Lang("WidgetThumb")</header>
            <label class="check main"><input type="checkbox" name="image" /><span>@this.Lang("WidgetThumb")</span></label>
        </div>
    </li>
</ul>
