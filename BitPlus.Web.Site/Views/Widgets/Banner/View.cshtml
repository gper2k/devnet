@model BitPlus.Web.Site.Widgets.SlotView
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    // 줄마다 "이미지 주소 | 링크 | 문구" — 이미지가 같은 사이트 경로(/…)나 http(s) 주소인 줄만, 링크도 같은 조건 (SlotView.SafeUrl)
    var items = Model.Lines("items").Where(p => BitPlus.Web.Site.Widgets.SlotView.SafeUrl(p[0]) is not null).ToList();
    // 높이(px) — 0 이면 비율(배너 2:1 = 스타일 기본, 세로형 배너 VerticalBanner 3:4), 값이 있으면 그 높이로 이미지를 잘라 채움
    var height = Model.Int("height", 0);
    var imageStyle = height > 0 ? $"aspect-ratio:auto;height:{height}px" : Model.Widget == "VerticalBanner" ? "aspect-ratio:3/4" : null;
}
@* 배너·슬라이드 위젯 — 이미지를 차례로 넘김(넘김 간격 초, 0 이면 멈춤), 아래 점을 누르면 그 배너로 *@
@if (items.Count > 0)
{
    <div class="widgetBanner" data-interval="@Model.Int("interval", 5)">
        <ul>
            @for (var i = 0; i < items.Count; i++)
            {
                var link = items[i].Length > 1 ? BitPlus.Web.Site.Widgets.SlotView.SafeUrl(items[i][1]) : null;
                var caption = items[i].Length > 2 ? items[i][2] : string.Empty;
                // /img/ 아래 SVG 가 CSS 변수를 쓰면 문서에 바로 넣어 레이아웃 색(다크 테마 포함)을 따르게 함, 아니면 이미지
                var svg = BitPlus.Web.Site.Widgets.SlotView.ThemeSvg(items[i][0], Env.WebRootPath, imageStyle, caption);
                <li class="@(i == 0 ? "active" : "")">
                    <a href="@(link ?? "#")">
                        @if (svg is not null)
                        {
                            @Html.Raw(svg)
                        }
                        else
                        {
                            <img src="@items[i][0]" alt="@caption" style="@imageStyle" />
                        }
                        @if (caption.Length > 0)
                        {
                            <span>@caption</span>
                        }
                    </a>
                </li>
            }
        </ul>
        @if (items.Count > 1)
        {
            <ol>
                @for (var i = 0; i < items.Count; i++)
                {
                    <li class="@(i == 0 ? "active" : "")"></li>
                }
            </ol>
        }
    </div>
    <script>
        (function (root) {
            const slides = [...root.querySelectorAll(':scope > ul > li')], dots = [...root.querySelectorAll(':scope > ol > li')];
            let index = 0;
            const show = i => {
                index = (i + slides.length) % slides.length;
                slides.forEach((li, n) => li.classList.toggle('active', n === index));
                dots.forEach((li, n) => li.classList.toggle('active', n === index));
            };
            dots.forEach((li, n) => li.onclick = () => show(n));
            const seconds = Number(root.dataset.interval);
            if (seconds > 0 && slides.length > 1) setInterval(() => show(index + 1), seconds * 1000);
        })(document.currentScript.previousElementSibling);
    </script>
}
