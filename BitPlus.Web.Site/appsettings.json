{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "LogPath": "/Logs/App"
  },
  "DbBuild": {
    "Prefix": "APP",
    "LogPath": "/Logs/DataBase"
  },
  "Path": {
    "UploadFolder": "/Uploads"
  },
  "Policies": {
    "SystemManager": {
      "Description": "통합 관리자",
      "Roles": [ "SystemManager" ]
    },
    "Manager": {
      "Description": "관리자 ",
      "Roles": [ "SystemManager", "Manager" ]
    },
    "AccountManager": {
      "Description": "계정 관리자",
      "Roles": [ "SystemManager", "AccountManager" ]
    },
    "ContentManager": {
      "Description": "컨텐츠 관리자",
      "Roles": [ "SystemManager", "ContentManager" ]
    },
    "Member": {
      "Description": "회원 전용",
      "Roles": [ "Member" ]
    }
  },
  "AllowedHosts": "*"
}
